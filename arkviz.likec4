specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpServer = service 'HTTP Server' {
      technology 'WSGI/ASGI'
      description 'Handles incoming HTTP requests and routes them to the application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/servers/basehttp.py'
      }

      projMiddleware = component 'Middleware' {
        description 'Hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Processes requests and returns responses using generic or functional views'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates with dynamic data'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/loader.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions, and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data and framework metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCache = cache 'Cache System' {
      technology 'Redis, Memcached, Database'
      description 'Stores frequently accessed data for performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projHttpServer -> projOrm 'queries data'
    projHttpServer -> projAuthSystem 'authenticates users'
    projHttpServer -> projCache 'caches responses'
    projAdminInterface -> projHttpServer 'uses'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAuthSystem -> projOrm 'persists users'
  }

  projExternalDb = external 'PostgreSQL' {
    description 'External database instance used in production/testing'
  }

  projMemcached = external 'Memcached' {
    description 'External memory caching system'
  }

  projDeveloper -> projDjangoFramework 'develops with'
  projEndUser -> projDjangoFramework.projHttpServer 'accesses web apps' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projExternalDb 'connects to' {
    technology 'TCP/IP'
  }
  projDjangoFramework.projCache -> projMemcached 'connects to'
}

deployment {
  projTestEnv = environment 'GitHub Actions CI' {
    projUbuntuNode = node 'Ubuntu Runner' {
      projPostgresNode = node 'PostgreSQL Service' {
        instanceOf projDjangoFramework.projDatabase
      }
      projPythonNode = node 'Python Runtime' {
        instanceOf projDjangoFramework.projHttpServer
        instanceOf projDjangoFramework.projOrm
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework and its interactions with developers, users, and external systems.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core containers of the Django framework including the HTTP handler, ORM, and Admin interface.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpServer {
    title 'Components - HTTP Server'
    description 'Internal request processing components within Djangos HTTP handling layer.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Testing'
    description 'How Django is deployed for automated testing in GitHub Actions.'
    include *
  }
}
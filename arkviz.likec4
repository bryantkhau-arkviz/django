specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Accesses web applications built with Django'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/__init__.py, django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Processes incoming web requests and returns responses'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Hooks into the request/response processing for security, sessions, and more'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and interacts with models/templates'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'invokes'
      projViewEngine -> projTemplateEngine 'renders with'
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and groups'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/auth/middleware.py'
      }
    }

    projManagementCli = service 'Management CLI' {
      technology 'Python'
      description 'Command-line interface for administrative tasks like migrations'
      metadata {
        sourceFiles 'django/core/management/__init__.py, django/core/management/base.py'
      }
    }

    projAdminInterface -> projHttpHandler 'uses'
    projHttpHandler -> projOrm 'queries data via'
    projHttpHandler -> projAuthSystem 'authenticates users via'
    projHttpHandler -> projCacheSystem 'caches responses in'
    projManagementCli -> projOrm 'manages schema via'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'Sends system emails and notifications'
  }

  projDeveloper -> projDjangoFramework.projManagementCli 'manages application' {
    technology 'Shell'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projEndUser -> projDjangoFramework.projHttpHandler 'accesses application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projHttpHandler -> projEmailService 'sends mail' {
    technology 'SMTP'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The high-level building blocks of the Django framework including the ORM, Admin, and HTTP handlers.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing pipeline within the Django HTTP Handler.'
    include *
  }
}
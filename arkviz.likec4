specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-powered web application'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and users via the Django Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWebHandler = service 'Web Handler (WSGI/ASGI)' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming HTTP requests and routes them to the appropriate view'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions or classes'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/conf.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'dispatches to'
      projViewEngine -> projTemplateEngine 'renders via'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database abstraction'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Built-in administration interface for managing models'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and groups'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskSystem = service 'Background Tasks' {
      technology 'Python'
      description 'Framework for asynchronous task execution'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projWebHandler -> projOrm 'queries data'
    projWebHandler -> projAuthSystem 'authenticates users'
    projWebHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projWebHandler 'uses'
    projWebHandler -> projTaskSystem 'triggers'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Primary data store for the application'
  }

  projEmailServer = external 'Email Service' {
    description 'External SMTP or API-based email delivery service'
  }

  projUser -> projDjangoFramework.projWebHandler 'accesses application' {
    technology 'HTTPS'
  }

  projAdmin -> projDjangoFramework.projAdminInterface 'manages site' {
    technology 'HTTPS'
  }

  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }

  projDjangoFramework.projWebHandler -> projEmailServer 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'Gunicorn/Uvicorn Worker' {
        instanceOf projDjangoFramework.projWebHandler
      }
    }
    projDbNode = node 'Managed Database Instance' {
      instanceOf projDatabase
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its interactions with users and external systems.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal containers of the Django framework including the web handler, ORM, and admin interface.'
    include *
  }

  view projectComponents of projDjangoFramework.projWebHandler {
    title 'Components - Web Handler'
    description 'Internal components of the Web Handler service, showing the request processing pipeline.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Production Environment'
    description 'Typical production deployment of a Django application.'
    include *
  }
}
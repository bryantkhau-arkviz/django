model {
  projUser = actor 'End User' {
    description 'A visitor or registered user of the Django-powered website'
  }

  projAdmin = actor 'Staff Administrator' {
    description 'Users with access to the Django Admin interface for data management'
  }

  projDeveloper = actor 'Software Developer' {
    description 'Developers building, testing, and deploying the Django application'
  }

  projDjangoSystem = system 'Django Application Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean design'

    projWebHandler = service 'Web Handler' {
      technology 'Python, ASGI/WSGI'
      description 'The core request/response processor handling HTTP traffic'

      projMiddleware = component 'Middleware Chain' {
        technology 'Python'
        description 'Hooks for security, sessions, and CSRF protection'
      }

      projUrlResolver = component 'URL Resolver' {
        technology 'Python'
        description 'Maps incoming URL patterns to specific view functions or classes'
      }

      projViewProcessor = component 'View Layer' {
        technology 'Python'
        description 'Encapsulates business logic and processes requests to return responses'
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates, Jinja2'
        description 'Renders dynamic HTML content using context data'
      }

      projORM = component 'Object-Relational Mapper (ORM)' {
        technology 'Python, sqlparse'
        description 'Maps Python models to database tables and handles query generation'
      }

      projAuthSystem = component 'Auth System' {
        technology 'Python, argon2/bcrypt'
        description 'Manages user authentication, permissions, and groups'
      }

      projMiddleware -> projUrlResolver 'passes sanitized request'
      projUrlResolver -> projViewProcessor 'routes to'
      projViewProcessor -> projAuthSystem 'validates permissions'
      projViewProcessor -> projORM 'queries data'
      projViewProcessor -> projTemplateEngine 'renders UI with'
    }

    projAdminUI = frontend 'Admin Interface' {
      technology 'Python, JavaScript, CSS'
      description 'Automatically generated administrative interface for model management'
    }

    projTaskWorker = service 'Background Worker' {
      technology 'Python (django.tasks)'
      description 'Processes asynchronous tasks and background jobs'
    }

    projDatabase = database 'Primary Database' {
      technology 'PostgreSQL/PostGIS, SQLite'
      description 'Relational data store for application models and content types'
    }

    projCacheLayer = cache 'Cache Backend' {
      technology 'Redis, Memcached'
      description 'Stores session data and fragments of rendered pages'
    }

    projStaticStorage = service 'Static/Media Storage' {
      technology 'Whitenoise, S3, Local Filesystem'
      description 'Serves CSS, JavaScript, images, and user-uploaded files'
    }

    projWebHandler -> projDatabase 'reads/writes data' {
      technology 'SQL'
    }
    projWebHandler -> projCacheLayer 'manages sessions/cache'
    projAdminUI -> projWebHandler 'uses core logic'
    projTaskWorker -> projDatabase 'processes records'
    projWebHandler -> projTaskWorker 'enqueues jobs'
  }

  projEmailProvider = external 'Email Service' {
    technology 'SMTP, SendGrid'
    description 'External service for sending transactional emails'
  }

  projTrac = external 'Django Trac' {
    description 'External ticket and issue tracking system for the Django project'
  }

  projGitHub = external 'GitHub Actions' {
    description 'CI/CD environment for running tests, linters, and benchmarks'
  }

  projFontAwesome = external 'Font Awesome' {
    technology 'SVG Icons'
    description 'Provides iconography for the Admin Interface'
  }

  projUser -> projDjangoSystem.projWebHandler 'browses site' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoSystem.projAdminUI 'manages application data' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoSystem.projWebHandler 'manages via django-admin CLI'
  projDeveloper -> projGitHub 'pushes code and runs workflows'
  projGitHub -> projTrac 'references tickets'
  projDjangoSystem.projWebHandler -> projEmailProvider 'sends notifications' {
    technology 'SMTP'
  }
  projDjangoSystem.projAdminUI -> projFontAwesome 'loads icons'
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level view of actors and external integrations for the Django ecosystem'
    include *
  }

  view projectContainers of projDjangoSystem {
    title 'Containers - Django Application'
    description 'The internal architecture of a standard Django deployment including database and workers'
    include *
  }

  view projectComponents of projDjangoSystem.projWebHandler {
    title 'Components - Web Handler'
    description 'Internal modules of the Django core handling the Request-Response lifecycle'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjango = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Web server interface for running Django applications'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/servers/basehttp.py'
      }

      projHttpHandler = component 'HTTP Handler' {
        description 'Processes incoming WSGI/ASGI requests and returns responses'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/core/handlers/wsgi.py, django/core/handlers/asgi.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projHttpHandler -> projMiddlewareChain 'passes request through'
      projMiddlewareChain -> projUrlResolver 'resolves URL'
      projUrlResolver -> projViewEngine 'calls view'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database abstraction'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminApp = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for model management'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and groups'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskSystem = queue 'Background Tasks' {
      technology 'Django Tasks API'
      description 'Framework for asynchronous and background task execution'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projDb = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py, django/db/backends/sqlite3/base.py'
      }
    }

    projWsgiServer.projViewEngine -> projOrm 'queries data'
    projWsgiServer.projViewEngine -> projTemplateEngine 'renders'
    projWsgiServer.projViewEngine -> projAuthSystem 'authenticates'
    projWsgiServer.projViewEngine -> projCacheSystem 'gets/sets'
    projWsgiServer.projViewEngine -> projTaskSystem 'enqueues'
    projOrm -> projDb 'executes SQL'
    projAdminApp -> projWsgiServer 'uses'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'Sends system notifications and user emails'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'S3, GCS, Local Filesystem'
    description 'Stores and serves static assets and user uploads'
  }

  projEndUser -> projDjango.projWsgiServer 'accesses application' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjango.projAdminApp 'manages data' {
    technology 'HTTPS'
  }
  projDjango.projWsgiServer -> projEmailService 'sends mail' {
    technology 'SMTP/HTTPS'
  }
  projDjango.projWsgiServer -> projStaticStorage 'stores/retrieves files' {
    technology 'Boto3/Filesystem'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'App Server' {
        instanceOf projDjango.projWsgiServer
      }
      projWorkerNode = node 'Task Worker' {
        instanceOf projDjango.projTaskSystem
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database' {
        instanceOf projDjango.projDb
      }
      projCacheNode = node 'Managed Redis' {
        instanceOf projDjango.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjango {
    title 'Containers - Django Web Framework'
    description 'Internal services and data stores of the Django framework'
    include *
  }

  view projectComponents of projDjango.projWsgiServer {
    title 'Components - Request Handling Pipeline'
    description 'Internal processing modules within the WSGI/ASGI handler'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Stack'
    description 'Standard production deployment architecture for Django'
    include *
  }
}
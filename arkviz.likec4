specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A person browsing or interacting with a Django-powered website'
  }

  projDeveloper = actor 'Django Developer' {
    description 'Develops and manages the Django application and its configuration'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Web server interface for handling HTTP requests and asynchronous events'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/servers/basehttp.py'
      }
    }

    projCoreHandler = service 'Django Core Handler' {
      technology 'Python'
      description 'The main request/response processing engine of the framework'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/core/handlers/exception.py'
      }

      projMiddleware = component 'Middleware Chain' {
        description 'Hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/static.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'Django ORM' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database interactions'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data and Django metadata'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py, django/db/backends/sqlite3/base.py'
      }
    }

    projCache = cache 'Cache Backend' {
      technology 'Redis, Memcached'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/redis.py'
      }
    }

    projWsgiServer -> projCoreHandler 'forwards requests' {
      technology 'WSGI/ASGI'
    }
    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCache 'caches data'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projCoreHandler 'uses'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'External service for sending emails'
  }

  projUser -> projDjangoFramework.projWsgiServer 'accesses website' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projCoreHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'Web Server Instance' {
        instanceOf projDjangoFramework.projWsgiServer
      }
      projLogicNode = node 'Django Application' {
        instanceOf projDjangoFramework.projCoreHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database (RDS/Cloud SQL)' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Managed Cache (ElastiCache/MemoryStore)' {
        instanceOf projDjangoFramework.projCache
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal architecture of the Django framework including handlers, ORM, and admin'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Django Core Handler'
    description 'Internal modules responsible for request processing, routing, and rendering'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Application'
    description 'Typical production deployment for a Django-based system'
    include *
  }
}
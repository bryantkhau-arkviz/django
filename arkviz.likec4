model {
  projDeveloper = actor 'Django Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'Application End User' {
    description 'Interacts with the web applications built on Django'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Interface between the web server and the Django application'
    }

    projCoreHandler = service 'Django Core Handler' {
      technology 'Python'
      description 'Main request/response processing engine'

      projMiddleware = component 'Middleware Layer' {
        description 'Hooks into request/response processing (Security, Session, CSRF, Auth)'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming URL patterns to view functions'
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates, Jinja2'
        description 'Renders dynamic HTML content'
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'dispatches to'
      projViewEngine -> projTemplateEngine 'uses for rendering'
    }

    projOrm = integration 'Django ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for site owners'
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Primary persistent data store'
    }

    projCache = cache 'Cache Framework' {
      technology 'Redis, Memcached'
      description 'Pluggable caching backend for performance'
    }

    projTaskQueue = queue 'Task Backend' {
      technology 'Django Tasks (Internal), Celery'
      description 'Handles asynchronous background processing'
    }

    projStaticFiles = service 'Static Files Handler' {
      description 'Manages CSS, JavaScript, and images'
    }

    projWsgiServer -> projCoreHandler 'forwards requests'
    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCache 'reads/writes'
    projCoreHandler -> projTaskQueue 'enqueues jobs'
    projOrm -> projDatabase 'executes SQL'
    projAdminInterface -> projCoreHandler 'uses API/Views'
  }

  projEmailProvider = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'External service for sending transactional emails'
  }

  projCloudStorage = external 'Object Storage' {
    technology 'Amazon S3, Google Cloud Storage'
    description 'Stores user-uploaded media files'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'configures and manages'
  projDeveloper -> projDjangoFramework.projCoreHandler 'writes views and logic'
  projEndUser -> projDjangoFramework.projWsgiServer 'accesses application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projCoreHandler -> projEmailProvider 'sends notifications'
  projDjangoFramework.projCoreHandler -> projCloudStorage 'uploads/retrieves media'
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django ecosystem and its interactions'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal technical building blocks of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Core Request Handler'
    description 'Internal request processing pipeline within the Django Core Handler'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Django Developer' {
    description 'Develops and maintains applications using the Django framework'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system'

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Django request/response processing (CSRF, Sessions, Auth, Security)'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes'
      }

      projViewSystem = component 'View System' {
        description 'Processes requests, interacts with models, and returns responses'
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2'
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewSystem 'calls view'
      projViewSystem -> projTemplateEngine 'renders response'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Provides an abstraction layer for database operations using Python objects'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing application data'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching system for improving performance'
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Asynchronous task execution and background processing'
    }

    projStaticFiles = service 'Static Files Handler' {
      technology 'Python'
      description 'Manages and serves CSS, JavaScript, and image files'
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCacheSystem 'caches responses/data'
    projWsgiHandler -> projTaskSystem 'triggers background tasks'
    projAdminInterface -> projWsgiHandler 'uses'
    projAdminInterface -> projOrm 'manages models'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Primary data store for Django applications'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Mailgun'
    description 'External service for sending notifications and transactional emails'
  }

  projGisService = external 'PostGIS / Geospatial' {
    technology 'PostGIS, GDAL, PROJ'
    description 'Spatial database extensions and libraries for GeoDjango'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses web app' {
    technology 'HTTPS'
  }

  projUser -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }

  projDeveloper -> projDjangoFramework 'builds applications'

  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }

  projDjangoFramework.projWsgiHandler -> projEmailService 'sends emails' {
    technology 'SMTP/HTTPS'
  }

  projDjangoFramework.projOrm -> projGisService 'spatial queries'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'Overview of the Django framework, its users, and external dependencies'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'Internal architecture of the Django framework showing core services and data flow'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal modules within the request handling pipeline'
    include *
  }
}
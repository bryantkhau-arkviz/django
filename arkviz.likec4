specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them to the appropriate view'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projRequestProcessor = component 'Request Processor' {
        description 'Processes raw WSGI/ASGI environments into HttpRequest objects'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/core/handlers/wsgi.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions or classes'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Executes a series of hooks during request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewExecutor = component 'View Executor' {
        description 'Executes the business logic defined in views'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projRequestProcessor -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves URL'
      projUrlResolver -> projViewExecutor 'calls view'
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python, SQL'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions, and cookie-based sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/views.py, django/contrib/auth/middleware.py'
      }
    }

    projCacheFramework = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database, Local Memory'
      description 'Pluggable caching system to reduce database load'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projTaskSystem = service 'Background Tasks' {
      technology 'Python'
      description 'Asynchronous task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders templates'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheFramework 'caches responses'
    projWsgiHandler -> projTaskSystem 'triggers background jobs'
    projAdminInterface -> projWsgiHandler 'uses'
    projAuthSystem -> projOrm 'persists user data'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Relational database for storing application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending emails'
  }

  projDeveloper -> projDjangoFramework 'builds apps with'
  projEndUser -> projDjangoFramework 'interacts with'
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework -> projEmailService 'sends notifications' {
    technology 'SMTP'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and systems that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django handler.'
    include *
  }
}
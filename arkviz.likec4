model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Django Developer' {
    description 'A developer building and maintaining Django applications'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpServer = service 'HTTP Server' {
      technology 'WSGI / ASGI'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
    }

    projCoreHandler = service 'Core Request Handler' {
      technology 'Python'
      description 'The heart of Django processing requests, middleware, and routing'

      projMiddleware = component 'Middleware Engine' {
        description 'Processes requests and responses globally (CSRF, Sessions, Auth)'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming URLs to the appropriate view functions'
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates / Jinja2'
        description 'Renders dynamic HTML content'
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'routes to'
      projViewEngine -> projTemplateEngine 'uses for rendering'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database abstraction'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin'
      description 'Automatic administrative interface for model management'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis / Memcached'
      description 'Pluggable caching backend for performance optimization'
    }

    projTaskQueue = queue 'Background Tasks' {
      technology 'Django Tasks'
      description 'Asynchronous task execution and scheduling'
    }

    projHttpServer -> projCoreHandler 'forwards requests'
    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCacheSystem 'caches results'
    projCoreHandler -> projTaskQueue 'enqueues tasks'
    projAdminInterface -> projCoreHandler 'uses'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL / SQLite / MySQL'
    description 'Persistent storage for application data'
  }

  projExternalEmail = external 'Email Service' {
    technology 'SMTP / API'
    description 'External service for sending notifications'
  }

  projUser -> projDjangoFramework.projHttpServer 'accesses application' {
    technology 'HTTPS'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }

  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }

  projDjangoFramework.projCoreHandler -> projExternalEmail 'sends mail' {
    technology 'SMTP'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django ecosystem and its interactions'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal architecture of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Core Request Handler'
    description 'Internal processing pipeline within the Django core handler'
    include *
  }
}
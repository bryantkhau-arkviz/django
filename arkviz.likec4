specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains applications using the Django framework'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them to the appropriate views'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projRequestProcessor = component 'Request Processor' {
        description 'Processes raw WSGI/ASGI environments into HttpRequest objects'
        metadata {
          sourceFiles 'django/core/handlers/wsgi.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Executes a series of hooks during request/response processing'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/middleware/common.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions or classes'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewExecutor = component 'View Executor' {
        description 'Executes the logic associated with a specific URL'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
        }
      }

      projRequestProcessor -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves URL'
      projUrlResolver -> projViewExecutor 'calls view'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Python, HTML, CSS, JS'
      description 'Automatic administrative interface for managing model data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Background task execution and management'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders views'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projOrm 'manages data'
    projAdminInterface -> projAuthSystem 'verifies admin access'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database for storage'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses web app' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'Gunicorn/Uvicorn Worker' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
      projAdminNode = node 'Admin Service' {
        instanceOf projDjangoFramework.projAdminInterface
      }
    }
    projDbZone = zone 'Database Cluster' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projPostgres
      }
    }
    projCacheNode = node 'Redis Instance' {
      instanceOf projDjangoFramework.projCacheSystem
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core internal services and systems of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Application'
    description 'Typical production deployment of a Django-based system.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projMiddleware = component 'Middleware Manager' {
        description 'Processes requests and responses through a chain of middleware'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/security.py, django/middleware/csrf.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles migrations'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/migrations/loader.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskSystem = service 'Background Tasks' {
      technology 'Python'
      description 'Asynchronous task execution and scheduling'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projHttpHandler -> projOrm 'queries data' {
      technology 'Python API'
    }
    projHttpHandler -> projCacheSystem 'caches responses' {
      technology 'Python API'
    }
    projAdminInterface -> projHttpHandler 'submits management actions' {
      technology 'HTTPS'
    }
    projHttpHandler -> projTaskSystem 'triggers background jobs'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database for data persistence'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending notifications and password resets'
  }

  projDeveloper -> projDjangoFramework 'configures and extends' {
    technology 'Python'
  }
  projEndUser -> projDjangoFramework.projHttpHandler 'accesses web application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projHttpHandler -> projEmailService 'sends emails' {
    technology 'SMTP'
  }
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestRunner = node 'Ubuntu Runner' {
      projPy314 = node 'Python 3.14' {
        instanceOf projDjangoFramework.projHttpHandler
      }
      projPostgresNode = node 'PostgreSQL Service' {
        instanceOf projPostgres
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural building blocks of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing pipeline within the Django HTTP Handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested within GitHub Actions infrastructure.'
    include *
  }
}
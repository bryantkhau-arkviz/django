specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler (WSGI/ASGI)' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them to the appropriate views'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/base.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareStack = component 'Middleware Stack' {
        description 'Hooks into request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projUrlResolver -> projMiddlewareStack 'routes to'
      projMiddlewareStack -> projViewEngine 'processes through'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Translates Python objects to database queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, CSS, JavaScript'
      description 'Automatic administrative interface for site management'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching backend'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projTemplateEngine 'renders views'
    projHttpHandler -> projAuthSystem 'authenticates users'
    projHttpHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projHttpHandler 'uses'
    projAuthSystem -> projOrm 'persists users/sessions'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'Sends notifications and password resets'
  }

  projDeveloper -> projDjangoFramework 'develops with'
  projEndUser -> projDjangoFramework.projHttpHandler 'accesses apps via HTTPS'
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework -> projEmailService 'sends emails'
}

deployment {
  projCI = environment 'GitHub Actions CI' {
    projTestNode = node 'Ubuntu Runner' {
      projPostgresNode = node 'PostgreSQL Service' {
        instanceOf projDatabase
      }
      projDjangoNode = node 'Django Test Environment' {
        instanceOf projDjangoFramework.projHttpHandler
      }
      projDjangoNode -> projPostgresNode 'runs tests against'
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Core subsystems of the Django framework including ORM, Templates, and Admin.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing components within the Django HTTP handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested in GitHub Actions with PostgreSQL.'
    include *
  }
}
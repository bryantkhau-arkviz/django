specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A person interacting with a Django-powered website'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains the Django application'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'The entry point for web servers to communicate with the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }

      projBaseHandler = component 'Base Handler' {
        description 'Coordinates middleware loading and response generation'
        metadata {
          sourceFiles 'django/core/handlers/base.py'
        }
      }

      projMiddleware = component 'Middleware Chain' {
        description 'Processes requests and responses globally (Security, CSRF, Sessions)'
        metadata {
          sourceFiles 'django/middleware/security.py, django/middleware/csrf.py, django/middleware/sessions.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projBaseHandler -> projMiddleware 'executes'
      projMiddleware -> projUrlResolver 'resolves path'
      projUrlResolver -> projViewEngine 'dispatches to'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Built-in automated administrative interface'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching backend'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Handles asynchronous background tasks'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders views'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projWsgiHandler -> projTaskQueue 'enqueues tasks'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projWsgiHandler 'uses'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'Sends system notifications and user emails'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'S3, Cloud Storage'
    description 'Hosts static files and user uploads'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses website' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail' {
    technology 'SMTP'
  }
  projDjangoFramework.projWsgiHandler -> projStaticStorage 'serves/uploads files'
}

deployment {
  projCI = environment 'GitHub Actions CI' {
    projTestRunner = node 'Test Runner' {
      technology 'Python 3.14, Ubuntu'
      instanceOf projDjangoFramework.projWsgiHandler
    }
    projPostgresNode = node 'PostgreSQL Service' {
      technology 'PostgreSQL 18-alpine'
      instanceOf projDjangoFramework.projDatabase
    }
    projTestRunner -> projPostgresNode 'runs tests against'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core internal services of the Django framework including the ORM, Template Engine, and Handlers.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django Handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested within the GitHub Actions CI pipeline.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projDeveloper = actor 'Django Developer' {
    description 'A developer building and maintaining applications using the Django framework'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the Web Server Gateway Interface'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests via the Asynchronous Server Gateway Interface'
    }

    projOrm = service 'Django ORM' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for interacting with various database backends'
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using template tags and filters'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing application data'
    }

    projMiddleware = service 'Middleware Layer' {
      technology 'Python'
      description 'Hooks into Djangos request/response processing for security, sessions, and more'
    }

    projUrlResolver = service 'URL Resolver' {
      technology 'Python'
      description 'Maps incoming URL paths to the appropriate view functions or classes'

      projResolver = component 'URL Resolver' {
        description 'Parses URL patterns and resolves them to views'
      }
      projConverter = component 'Path Converters' {
        description 'Converts URL path segments into Python types'
      }
      projConf = component 'URL Configuration' {
        description 'Loads and manages URL patterns from urls.py'
      }

      projConf -> projResolver 'provides patterns to'
      projResolver -> projConverter 'uses for type conversion'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching backend for performance optimization'
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Python'
      description 'Internal task execution system for background processing'
    }

    projWsgiHandler -> projMiddleware 'passes request through'
    projAsgiHandler -> projMiddleware 'passes request through'
    projMiddleware -> projUrlResolver 'requests resolution for'
    projUrlResolver -> projTemplateEngine 'triggers view rendering'
    projTemplateEngine -> projOrm 'fetches data via'
    projOrm -> projCacheSystem 'reads/writes cached data'
    projAdminInterface -> projWsgiHandler 'uses for management'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database backend used in CI/CD and production'
  }

  projGitHubActions = external 'GitHub Actions' {
    technology 'YAML'
    description 'CI/CD platform for running tests, benchmarks, and coverage'
  }

  projTrac = external 'Trac' {
    description 'Issue tracking system for the Django project'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses web app' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'persists data' {
    technology 'SQL'
  }
  projGitHubActions -> projDjangoFramework 'runs tests and benchmarks'
  projDeveloper -> projTrac 'reports bugs and tracks features'
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django Framework and its ecosystem'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and components of the Django Framework'
    include *
  }

  view projectComponents of projDjangoFramework.projUrlResolver {
    title 'Components - URL Resolver'
    description 'Internal modules within the URL Resolver service'
    include *
  }
}
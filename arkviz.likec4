specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and users via the Django Admin interface'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Web server interface for handling synchronous and asynchronous requests'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projCoreHandler = service 'Django Core Handler' {
      technology 'Python'
      description 'The core request/response processing engine'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/core/handlers/exception.py'
      }

      projMiddleware = component 'Middleware Chain' {
        description 'Hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'Django ORM' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database interactions'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'Built-in administration interface'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Auth System' {
      technology 'Python'
      description 'Handles authentication, permissions, and user sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/models.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py'
      }
    }

    projCache = cache 'Cache Backend' {
      technology 'Redis, Memcached'
      description 'Pluggable caching system'
      metadata {
        sourceFiles 'django/core/cache/backends/redis.py'
      }
    }

    projWsgiServer -> projCoreHandler 'forwards requests'
    projCoreHandler -> projAuthSystem 'authenticates'
    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCache 'caches data'
    projAdminInterface -> projCoreHandler 'uses'
    projOrm -> projDatabase 'executes SQL'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API based email delivery'
  }

  projUser -> projDjangoFramework.projWsgiServer 'accesses app' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projCoreHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projCloudZone = zone 'Cloud Provider' {
      projAppNode = node 'Application Server' {
        instanceOf projDjangoFramework.projWsgiServer
        instanceOf projDjangoFramework.projCoreHandler
      }
      projDbNode = node 'Managed Database' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Managed Cache' {
        instanceOf projDjangoFramework.projCache
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of Django and its interactions with users and external systems'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'Internal architecture of the Django framework including handlers, ORM, and admin'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Django Core Handler'
    description 'Internal components of the request/response processing engine'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Application'
    description 'Typical production deployment of a Django-based system'
    include *
  }
}
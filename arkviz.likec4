specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and manages Django applications and the framework itself'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the Web Server Gateway Interface'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/servers/basehttp.py'
      }

      projRequestFactory = component 'Request Factory' {
        description 'Creates WSGIRequest objects from environment dictionaries'
        metadata {
          sourceFiles 'django/core/handlers/wsgi.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a configurable stack of middleware'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/middleware/common.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewProcessor = component 'View Processor' {
        description 'Executes the application logic associated with a URL'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projRequestFactory -> projMiddlewareChain 'passes request to'
      projMiddlewareChain -> projUrlResolver 'resolves URL via'
      projUrlResolver -> projViewProcessor 'dispatches to'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests via the Asynchronous Server Gateway Interface'
      metadata {
        sourceFiles 'django/core/handlers/asgi.py, django/core/asgi.py'
      }
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python'
      description 'Maps database tables to Python classes and provides an API for querying'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Python, Jinja2'
      description 'Renders dynamic HTML content using Django or Jinja2 templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, JavaScript, CSS'
      description 'Automatic administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache System' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching framework for improving performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projTaskQueue = queue 'Task Backend' {
      technology 'Python'
      description 'Pluggable backend for asynchronous task execution'
      metadata {
        sourceFiles 'django/tasks/backends/base.py, django/tasks/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data via'
    projAsgiHandler -> projOrm 'queries data via'
    projWsgiHandler -> projTemplateEngine 'renders UI with'
    projWsgiHandler -> projCacheSystem 'caches results in'
    projOrm -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projAdminInterface -> projWsgiHandler 'uses'
    projWsgiHandler -> projTaskQueue 'enqueues tasks to'
  }

  projExternalAuth = external 'Auth Provider' {
    description 'External authentication services (OAuth, OpenID)'
  }

  projEmailService = external 'Email Service' {
    description 'SMTP or API-based email delivery services'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }
  projUser -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework 'configures and extends'
  projDjangoFramework.projWsgiHandler -> projExternalAuth 'authenticates via'
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends notifications via'
}

deployment {
  projProdEnv = environment 'Production' {
    projWebZone = zone 'Web Tier' {
      projAppServer = node 'Gunicorn / Uvicorn' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
      projAsgiServer = node 'Daphne / Uvicorn' {
        instanceOf projDjangoFramework.projAsgiHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'PostgreSQL Cluster' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Redis Cluster' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural components of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing pipeline within the WSGI Handler'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Production Environment'
    description 'Typical deployment architecture for a Django application'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projDeveloper = actor 'Django Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'Web User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the Web Server Gateway Interface'
      
      projMiddleware = component 'Middleware Stack' {
        description 'Processes requests and responses globally (Auth, CSRF, Sessions, etc.)'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming URL paths to the appropriate view functions'
      }
      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
      }
      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2'
      }

      projMiddleware -> projUrlResolver 'passes processed request'
      projUrlResolver -> projViewEngine 'routes to'
      projViewEngine -> projTemplateEngine 'uses for rendering'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests and protocols like WebSockets'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, JavaScript, CSS'
      description 'Automatic administrative interface for managing site content'
    }

    projOrm = service 'Django ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction'
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL/MySQL/SQLite'
      description 'Stores application data and metadata'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis/Memcached'
      description 'Pluggable caching backend for performance optimization'
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Internal task management and background processing'
    }

    projWsgiHandler -> projOrm 'queries data'
    projAsgiHandler -> projOrm 'queries data'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projWsgiHandler -> projCacheSystem 'reads/writes'
    projAdminInterface -> projWsgiHandler 'uses'
    projWsgiHandler -> projTaskQueue 'enqueues jobs'
  }

  projExternalEmail = external 'Email Service' {
    description 'External SMTP or API-based email delivery'
  }

  projExternalGis = external 'GIS Services' {
    description 'Geospatial data services (PostGIS, GDAL)'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses app' {
    technology 'HTTPS'
  }
  projEndUser -> projDjangoFramework.projAsgiHandler 'accesses real-time features' {
    technology 'WebSockets'
  }
  projDjangoFramework.projWsgiHandler -> projExternalEmail 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projOrm -> projExternalGis 'integrates with' {
    technology 'C Libraries'
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'The core architectural components of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing pipeline within the WSGI Handler.'
    include *
  }
}
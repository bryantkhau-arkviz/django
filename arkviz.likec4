specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and users via the Django Admin interface'
  }

  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projDjangoSystem = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiAsgiHandler = service 'Request Handler (WSGI/ASGI)' {
      technology 'Python, ASGIRef'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareStack = component 'Middleware Stack' {
        description 'Processes requests and responses globally (CSRF, Sessions, Auth, Security)'
        metadata {
          sourceFiles 'django/middleware/csrf.py, django/contrib/sessions/middleware.py, django/contrib/auth/middleware.py, django/middleware/security.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
        }
      }

      projUrlResolver -> projMiddlewareStack 'routes to'
      projMiddlewareStack -> projViewEngine 'invokes'
      projViewEngine -> projTemplateEngine 'renders with'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQLParse'
      description 'Provides an abstraction layer for database operations'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, JavaScript, CSS'
      description 'Built-in administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/options.py, django/contrib/admin/sites.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python, Argon2, Bcrypt'
      description 'Handles user authentication, permissions, and session management'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/models.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data and framework metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projWsgiAsgiHandler -> projOrm 'queries data'
    projWsgiAsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiAsgiHandler -> projCacheSystem 'caches responses/data'
    projAdminInterface -> projWsgiAsgiHandler 'uses'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAuthSystem -> projOrm 'persists users/sessions'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery service'
  }

  projGisService = external 'GIS Libraries' {
    technology 'GDAL, PROJ, GEOS'
    description 'Geospatial libraries for GeoDjango support'
  }

  projUser -> projDjangoSystem.projWsgiAsgiHandler 'accesses application' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoSystem.projAdminInterface 'manages site' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoSystem 'configures and extends'
  projDjangoSystem.projWsgiAsgiHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
  projDjangoSystem.projOrm -> projGisService 'performs spatial queries'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Tier' {
      projWebServer = node 'Gunicorn / Daphne' {
        instanceOf projDjangoSystem.projWsgiAsgiHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database (RDS/Cloud SQL)' {
        instanceOf projDjangoSystem.projDatabase
      }
      projCacheNode = node 'Managed Redis' {
        instanceOf projDjangoSystem.projCacheSystem
      }
    }
    projWebServer -> projDbNode 'connects'
    projWebServer -> projCacheNode 'connects'
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoSystem {
    title 'Containers - Django Web Framework'
    description 'The core architectural building blocks of the Django framework.'
    include *
  }

  view projectComponents of projDjangoSystem.projWsgiAsgiHandler {
    title 'Components - Request Handler'
    description 'Internal modules within the Django request/response handling pipeline.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard deployment architecture for a Django-based application.'
    include *
  }
}
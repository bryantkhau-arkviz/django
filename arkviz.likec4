specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-powered website'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains the Django application'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system.'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing.'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions.'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewSystem = component 'View System' {
        description 'Processes requests and returns responses using generic or functional views.'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py, django/views/generic/edit.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends.'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewSystem 'calls view'
      projViewSystem -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles migrations.'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/migrations/executor.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content.'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions, and cookie-based user sessions.'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/auth/middleware.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable cache backend for performance optimization.'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Backend for asynchronous task execution.'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projOrm 'manages models'
    projAdminInterface -> projAuthSystem 'verifies permissions'
    projWsgiHandler -> projTaskSystem 'triggers background jobs'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data and Django metadata.'
  }

  projExternalAuth = external 'External Auth Provider' {
    description 'OAuth/OpenID providers (e.g., Google, GitHub) often integrated via third-party apps.'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Mailgun'
    description 'Sends system notifications and password resets.'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projUser -> projDjangoFramework.projWsgiHandler 'visits website' {
    technology 'HTTPS'
  }
  projUser -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projAuthSystem -> projExternalAuth 'delegates auth'
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail'
  projDeveloper -> projDjangoFramework 'configures and deploys'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'Gunicorn/Uvicorn Worker' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
      projAdminNode = node 'Admin Instance' {
        instanceOf projDjangoFramework.projAdminInterface
      }
    }
    projDbZone = zone 'Database Cluster' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projDatabase
      }
    }
    projCacheNode = node 'Redis Instance' {
      instanceOf projDjangoFramework.projCacheSystem
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services of the Django framework including the ORM, Admin, and Auth systems.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Application'
    description 'Typical production deployment for a Django-based system.'
    include *
  }
}
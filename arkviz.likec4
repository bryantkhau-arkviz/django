specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projDeveloper = actor 'Django Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Accesses web applications built with Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system.'

      projMiddleware = component 'Middleware Stack' {
        description 'Processes requests and responses globally (Security, CSRF, Sessions, Auth).'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes.'
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses.'
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates, Jinja2'
        description 'Renders dynamic HTML content using context data.'
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders data'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Provides an abstraction layer for database operations using Python models.'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin, JavaScript'
      description 'Automatic administrative interface for managing application data.'
    }

    projManagementCli = service 'Management CLI' {
      technology 'Python, django-admin'
      description 'Command-line utility for administrative tasks like migrations and server management.'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching system for improving performance.'
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Asynchronous task execution and background processing.'
    }

    projMainDb = database 'Primary Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Relational database for persistent storage of application data.'
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCacheSystem 'reads/writes cache'
    projWsgiHandler -> projTaskSystem 'enqueues tasks'
    projAdminInterface -> projWsgiHandler 'uses'
    projOrm -> projMainDb 'executes SQL'
    projManagementCli -> projOrm 'manages schema'
  }

  projExternalEmail = external 'Email Service' {
    technology 'SMTP, SendGrid'
    description 'Sends notifications and transactional emails.'
  }

  projExternalGis = external 'GIS Services' {
    technology 'PostGIS, GDAL'
    description 'Geospatial data processing and storage.'
  }

  projDeveloper -> projDjangoFramework.projManagementCli 'runs commands'
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data'
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projExternalEmail 'sends mail'
  projDjangoFramework.projOrm -> projExternalGis 'processes spatial data'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'Internal services and data stores that make up the framework architecture.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django handler.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing the web application built with Django'
  }

  projAdmin = actor 'Site Administrator' {
    description 'A user managing the site via the Django Admin interface'
  }

  projDeveloper = actor 'Developer' {
    description 'A developer using the Django framework to build applications'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view layers.'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projMiddleware = component 'Middleware Stack' {
        technology 'Python'
        description 'Hooks into Djangos request/response processing.'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        technology 'Python'
        description 'Maps requested URLs to the appropriate view functions.'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewLayer = component 'View Layer' {
        technology 'Python'
        description 'Processes requests and returns responses, often interacting with models and templates.'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates, Jinja2'
        description 'Renders dynamic HTML content.'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewLayer 'calls view'
      projViewLayer -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles database queries.'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminApp = service 'Admin Interface' {
      technology 'Python, HTML, JS'
      description 'A built-in, customizable administration interface for managing site content.'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, sessions, and permissions.'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/middleware.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data.'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCache = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Provides a unified interface for various caching backends.'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCache 'caches responses'
    projAdminApp -> projOrm 'manages models'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAuthSystem -> projOrm 'persists users/sessions'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending emails.'
  }

  projPostgis = external 'PostGIS' {
    technology 'PostgreSQL Extension'
    description 'Spatial database extender for PostgreSQL.'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses app' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminApp 'manages site' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework 'builds with'
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail' {
    technology 'SMTP'
  }
  projDjangoFramework.projOrm -> projPostgis 'spatial queries'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Server' {
      projWebNode = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
    }
    projDbZone = zone 'Database Cluster' {
      projDbNode = node 'PostgreSQL Instance' {
        instanceOf projDjangoFramework.projDatabase
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and data stores within the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal components of the request handling pipeline.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Setup'
    description 'How Django is typically deployed in a production environment.'
    include *
  }
}
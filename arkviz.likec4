specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projAdminUser = actor 'Site Administrator' {
    description 'A user managing the site via the Django Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system.'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing.'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions or classes.'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewSystem = component 'View System' {
        description 'Processes requests and returns responses using generic or functional views.'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends.'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewSystem 'calls view'
      projViewSystem -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for interacting with relational databases.'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projAdminApp = service 'Admin Interface' {
      technology 'Python, JavaScript, CSS'
      description 'Automatic administrative interface for managing model data.'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and groups.'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projSessionStore = database 'Session Store' {
      technology 'Database/Cache'
      description 'Stores user session data.'
      metadata {
        sourceFiles 'django/contrib/sessions/models.py, django/contrib/sessions/middleware.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis/Memcached'
      description 'Pluggable cache backend for performance optimization.'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data' {
      technology 'Python API'
    }
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projSessionStore 'manages sessions'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projAdminApp -> projOrm 'manages models'
    projAdminApp -> projAuthSystem 'verifies permissions'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database (as seen in CI/CD configs).'
  }

  projEmailService = external 'SMTP/Email Service' {
    description 'External service for sending notifications.'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses app' {
    technology 'HTTPS'
  }
  projAdminUser -> projDjangoFramework.projAdminApp 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail' {
    technology 'SMTP'
  }
}

deployment {
  projCI = environment 'GitHub Actions CI' {
    projTestNode = node 'Ubuntu Runner' {
      projPostgresInstance = node 'PostgreSQL Service' {
        instanceOf projPostgres
      }
      projDjangoTest = node 'Django Test Process' {
        instanceOf projDjangoFramework
      }
      projDjangoTest -> projPostgresInstance 'runs migrations and tests'
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and data stores of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - Request Handler'
    description 'Internal components of the WSGI/ASGI request handling system.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested in the GitHub Actions environment.'
    include *
  }
}
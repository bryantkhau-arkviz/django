model {
  projUser = actor 'End User' {
    description 'A user interacting with the web application'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content, users, and configuration via the Admin interface'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains the application using the Django framework'
  }

  projDjangoSystem = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWebFrontend = frontend 'Web Application' {
      technology 'HTML, CSS, JavaScript, Jinja'
      description 'The user-facing web interface rendered by Django templates'
    }

    projDjangoApp = service 'Django Application Server' {
      technology 'Python, Django, ASGIRef'
      description 'Core application logic handling requests, middleware, and business rules'

      projMiddleware = component 'Middleware Layer' {
        description 'Hooks into request/response processing (CSRF, Session, Auth, Security)'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming HTTP requests to the appropriate view functions'
      }

      projViewEngine = component 'View Engine' {
        description 'Processes business logic and interacts with models'
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML responses using Django or Jinja2 templates'
      }

      projOrm = component 'Object-Relational Mapper (ORM)' {
        description 'Translates Python objects to database queries'
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'routes to'
      projViewEngine -> projOrm 'queries data'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Contrib Admin'
      description 'Built-in administrative interface for managing application data'
    }

    projPostgresDb = database 'PostgreSQL' {
      technology 'PostgreSQL'
      description 'Primary relational database for persistent storage'
    }

    projRedisCache = cache 'Cache Layer' {
      technology 'Redis / Memcached'
      description 'Caches frequent queries and session data'
    }

    projStaticFiles = service 'Static Files Storage' {
      technology 'Django StaticFiles'
      description 'Serves CSS, JavaScript, and images'
    }

    projWebFrontend -> projDjangoApp 'sends HTTP requests' {
      technology 'HTTP/HTTPS'
    }
    projAdminInterface -> projDjangoApp 'manages data' {
      technology 'HTTP/HTTPS'
    }
    projDjangoApp -> projPostgresDb 'reads/writes data' {
      technology 'SQL'
    }
    projDjangoApp -> projRedisCache 'caches data' {
      technology 'Redis Protocol'
    }
    projDjangoApp -> projStaticFiles 'collects/serves'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP / SendGrid'
    description 'External service for sending notifications and password resets'
  }

  projExternalAuth = external 'Auth Provider' {
    technology 'OAuth2 / OpenID Connect'
    description 'Third-party authentication provider'
  }

  projUser -> projDjangoSystem.projWebFrontend 'browses'
  projAdmin -> projDjangoSystem.projAdminInterface 'administers'
  projDeveloper -> projDjangoSystem.projDjangoApp 'configures and deploys'
  projDjangoSystem.projDjangoApp -> projEmailService 'sends emails'
  projDjangoSystem.projDjangoApp -> projExternalAuth 'authenticates via'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django system and its environment'
    include *
  }

  view projectContainers of projDjangoSystem {
    title 'Containers - Django Web Framework'
    description 'The internal architecture of the Django system'
    include *
  }

  view projectComponents of projDjangoSystem.projDjangoApp {
    title 'Components - Django Application Server'
    description 'Internal components of the core Django application service'
    include *
  }
}
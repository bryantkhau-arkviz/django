specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing the web application built with Django'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages the application via the built-in Django Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Web server interface for running Python web applications'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/servers/basehttp.py'
      }
    }

    projCoreApp = service 'Django Core' {
      technology 'Python, Django'
      description 'The core framework handling requests, routing, and business logic'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/conf/global_settings.py, django/apps/registry.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming URL patterns to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses globally (CSRF, Sessions, Auth)'
        metadata {
          sourceFiles 'django/middleware/csrf.py, django/contrib/sessions/middleware.py, django/contrib/auth/middleware.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/template/response.py'
        }
      }

      projOrm = component 'Object-Relational Mapper (ORM)' {
        description 'Translates Python code into database queries'
        metadata {
          sourceFiles 'django/db/models/query.py, django/db/models/base.py, django/db/backends/utils.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'invokes'
      projViewEngine -> projOrm 'queries data'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing model data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data and framework metadata'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py, django/db/backends/sqlite3/base.py'
      }
    }

    projCache = cache 'Cache Layer' {
      technology 'Redis, Memcached'
      description 'Pluggable caching framework for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/redis.py'
      }
    }

    projTaskQueue = queue 'Background Tasks' {
      technology 'Django Tasks, Celery'
      description 'Handles asynchronous background processing'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projWsgiServer -> projCoreApp 'forwards requests'
    projCoreApp -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projCoreApp -> projCache 'gets/sets'
    projCoreApp -> projTaskQueue 'enqueues'
    projAdminInterface -> projCoreApp 'calls'
  }

  projEmailProvider = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'Sends transactional and notification emails'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'Amazon S3, WhiteNoise'
    description 'Hosts static assets and user-uploaded files'
  }

  projUser -> projDjangoFramework.projWsgiServer 'accesses app' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projCoreApp -> projEmailProvider 'sends mail'
  projDjangoFramework.projCoreApp -> projStaticStorage 'serves files'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'Web Server Instance' {
        instanceOf projDjangoFramework.projWsgiServer
      }
      projLogicNode = node 'Django Application' {
        instanceOf projDjangoFramework.projCoreApp
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database (RDS)' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Managed Cache (ElastiCache)' {
        instanceOf projDjangoFramework.projCache
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal services and data stores of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreApp {
    title 'Components - Django Core'
    description 'Internal architectural components of the Django Core service'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Production Environment'
    description 'Typical production deployment of a Django application'
    include *
  }
}
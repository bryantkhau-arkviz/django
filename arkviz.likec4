specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjango = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and dispatches them to the appropriate view'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the corresponding view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a series of hooks'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'executes'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps Python objects to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Python, HTML, CSS'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database'
      description 'Pluggable caching system for improving performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Python'
      description 'Handles asynchronous tasks and background processing'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projWsgiHandler -> projTaskQueue 'enqueues tasks'
    projAdminInterface -> projOrm 'manages data'
    projOrm -> projCacheSystem 'caches queries'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'Sends emails to users'
  }

  projDeveloper -> projDjango 'develops apps with'
  projEndUser -> projDjango.projWsgiHandler 'accesses apps via HTTPS'
  projDjango.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjango.projWsgiHandler -> projEmailService 'sends mail'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppServer = zone 'Application Server' {
      projGunicorn = node 'Gunicorn / Uvicorn' {
        instanceOf projDjango.projWsgiHandler
      }
      projDjangoApp = node 'Django Application' {
        instanceOf projDjango.projOrm
        instanceOf projDjango.projTemplateEngine
      }
    }
    projDbServer = zone 'Database Cluster' {
      projPostgresNode = node 'PostgreSQL' {
        instanceOf projDatabase
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjango {
    title 'Containers - Django Framework'
    description 'The core services and components of the Django framework.'
    include *
  }

  view projectComponents of projDjango.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing components within the Handler service.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Application'
    description 'Typical production deployment of a Django-based system.'
    include *
  }
}
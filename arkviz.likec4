specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Accesses web applications built with Django'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/__init__.py, django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCoreHandler = service 'Request Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Core request/response processing engine supporting both synchronous and asynchronous protocols'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/core/handlers/wsgi.py, django/core/handlers/asgi.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses globally (Security, CSRF, Sessions, Auth)'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py, django/contrib/auth/middleware.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'invokes'
      projViewEngine -> projTemplateEngine 'renders via'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps database tables to Python classes and handles complex queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projMigrationSystem = service 'Migration System' {
      technology 'Python'
      description 'Propagates changes made to models into the database schema'
      metadata {
        sourceFiles 'django/db/migrations/executor.py, django/db/migrations/loader.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system to improve performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions, and cookie-based sessions'
      metadata {
        sourceFiles 'django/contrib/auth/__init__.py, django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Python'
      description 'Backend for asynchronous task execution'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCacheSystem 'caches responses/data'
    projCoreHandler -> projAuthSystem 'authenticates users'
    projCoreHandler -> projTaskSystem 'triggers background jobs'
    projAdminInterface -> projCoreHandler 'uses'
    projMigrationSystem -> projOrm 'inspects models'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database for data storage'
  }

  projRedis = cache 'Redis' {
    technology 'Redis'
    description 'In-memory data structure store used as a cache or task broker'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending notifications and password resets'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data'
  projDeveloper -> projDjangoFramework.projMigrationSystem 'updates schema'
  projEndUser -> projDjangoFramework.projCoreHandler 'interacts with app' {
    technology 'HTTPS'
  }

  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projCacheSystem -> projRedis 'stores data'
  projDjangoFramework.projCoreHandler -> projEmailService 'sends emails'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Tier' {
      projWebServer = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projCoreHandler
      }
      projAdminServer = node 'Admin Instance' {
        instanceOf projDjangoFramework.projAdminInterface
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projPostgres
      }
      projCacheNode = node 'Managed Redis' {
        instanceOf projRedis
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal services and systems that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Request Handler'
    description 'Internal architecture of the Django request/response processing engine.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'A standard production deployment of a Django-based application.'
    include *
  }
}
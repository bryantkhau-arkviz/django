specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projDeveloper = actor 'Django Developer' {
    description 'A developer using the Django framework to build and test applications'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests using the WSGI standard'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Manager' {
        description 'Manages the execution of request and response middleware'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/middleware/common.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming URL paths to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewProcessor = component 'View Processor' {
        description 'Executes the business logic for a specific request'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewProcessor 'dispatches to'
      projViewProcessor -> projTemplateEngine 'renders via'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests and protocols like WebSockets'
      metadata {
        sourceFiles 'django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Abstraction layer for database operations and migrations'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/migrations/loader.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskSystem = queue 'Task System' {
      technology 'Python'
      description 'Backend-agnostic task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data' {
      technology 'SQL'
    }
    projAsgiHandler -> projOrm 'queries data' {
      technology 'SQL'
    }
    projWsgiHandler -> projCacheSystem 'reads/writes'
    projAdminInterface -> projWsgiHandler 'uses'
    projWsgiHandler -> projTaskSystem 'triggers tasks'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Relational database used for testing and production deployments'
  }

  projSqlite = database 'SQLite' {
    technology 'SQLite'
    description 'Lightweight database used for local development and testing'
  }

  projEmailService = external 'SMTP/Email Service' {
    description 'External service for sending notifications and system emails'
  }

  projGitHubActions = external 'GitHub Actions' {
    description 'CI/CD platform running benchmarks, tests, and linters'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses app' {
    technology 'HTTPS'
  }
  projUser -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projOrm 'manages schema' {
    technology 'Python/CLI'
  }
  projDjangoFramework.projOrm -> projPostgres 'persists data' {
    technology 'SQL'
  }
  projDjangoFramework.projOrm -> projSqlite 'persists data' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail' {
    technology 'SMTP'
  }
  projGitHubActions -> projDjangoFramework 'runs tests on'
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal services and handlers that make up the Django framework core.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing pipeline within the WSGI Handler.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A person accessing a website built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'A software engineer using Django to build and manage web applications'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'The entry point for web servers to communicate with the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to views'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Processes requests and returns responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/defaults.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python'
      description 'Maps database tables to Python classes'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for site owners'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Auth System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/middleware.py, django/contrib/sessions/middleware.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projWsgiHandler 'uses'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAuthSystem -> projDatabase 'persists users/sessions'
  }

  projExternalMail = external 'Email Service' {
    description 'SMTP server or third-party email API'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'visits website' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projExternalMail 'sends emails' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projWebZone = zone 'Web Tier' {
      projWebServer = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'PostgreSQL Cluster' {
        instanceOf projDjangoFramework.projDatabase
      }
      projRedisNode = node 'Redis' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and data stores of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline components'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard production deployment using WSGI/ASGI servers and managed databases'
    include *
  }
}
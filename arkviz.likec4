specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains applications using the Django framework'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpServer = service 'HTTP Server' {
      technology 'WSGI/ASGI (Gunicorn, Uvicorn)'
      description 'Handles incoming HTTP requests and routes them to the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/servers/basehttp.py'
      }

      projRequestProcessor = component 'Request Processor' {
        description 'Processes incoming WSGI/ASGI requests into Django HttpRequest objects'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/core/handlers/wsgi.py, django/core/handlers/asgi.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Executes a series of hooks during request/response processing (Security, Session, Auth, CSRF)'
        metadata {
          sourceFiles 'django/middleware/security.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py, django/contrib/auth/middleware.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HttpResponse objects'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py, django/views/generic/edit.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
        }
      }

      projRequestProcessor -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves URL'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles migrations'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/migrations/loader.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing model data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projTaskSystem = queue 'Task Queue Interface' {
      technology 'Pluggable Backends'
      description 'Interface for background task execution'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projHttpServer -> projOrm 'queries data' {
      technology 'Python DB-API'
    }
    projHttpServer -> projCacheSystem 'caches responses/data'
    projHttpServer -> projTaskSystem 'triggers background tasks'
    projAdminInterface -> projHttpServer 'uses'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'Sends system notifications and user emails'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projUser -> projDjangoFramework.projHttpServer 'accesses web app' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projHttpServer -> projEmailService 'sends mail' {
    technology 'SMTP/API'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Server' {
      projWebNode = node 'Gunicorn/Uvicorn Container' {
        instanceOf projDjangoFramework.projHttpServer
      }
    }
    projDbZone = zone 'Database Cluster' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projDatabase
      }
    }
    projCacheZone = zone 'Cache Cluster' {
      projRedisNode = node 'Redis Instance' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural components of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpServer {
    title 'Components - HTTP Request Handler'
    description 'Internal request processing pipeline within Django'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Stack'
    description 'Standard deployment architecture for a Django-based application'
    include *
  }
}
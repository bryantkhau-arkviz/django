specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with the Django-based web application'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages application content and users via the Django Admin interface'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean design.'

    projWsgiAsgiHandler = service 'Request Handler (WSGI/ASGI)' {
      technology 'Python, ASGIRef'
      description 'Entry point for web servers to communicate with the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Processes logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQLParse'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Built-in administrative interface for managing models'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python, Argon2, Bcrypt'
      description 'Handles user authentication, permissions, and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/models.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data, user accounts, and sessions'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching backend for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projWsgiAsgiHandler -> projOrm 'queries data'
    projWsgiAsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiAsgiHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projWsgiAsgiHandler 'uses'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAuthSystem -> projOrm 'persists users'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery'
  }

  projGeoService = external 'GeoIP/GIS' {
    technology 'GDAL, PROJ'
    description 'Geospatial data services'
    metadata {
      sourceFiles 'django/contrib/gis/geoip2.py'
    }
  }

  projUser -> projDjangoFramework.projWsgiAsgiHandler 'accesses web app' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiAsgiHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projWsgiAsgiHandler -> projGeoService 'resolves locations'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Server' {
      projWebNode = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projWsgiAsgiHandler
      }
    }
    projDataZone = zone 'Database Cluster' {
      projDbNode = node 'PostgreSQL Instance' {
        instanceOf projDjangoFramework.projDatabase
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core internal containers of the Django framework including the ORM, Auth, and Admin.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiAsgiHandler {
    title 'Components - Request Handler'
    description 'Internal request processing pipeline within Django core handlers.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Setup'
    description 'Standard deployment architecture for a Django application.'
    include *
  }
}
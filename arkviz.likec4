specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI/ASGI'
      description 'Handles incoming HTTP requests via WSGI or ASGI interfaces'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Manager' {
        description 'Processes requests and responses through a chain of middleware'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/middleware/common.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'dispatches to'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'HTML, CSS, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projManagementCli = service 'Management CLI' {
      technology 'Python'
      description 'Command-line utility for administrative tasks'
      metadata {
        sourceFiles 'django/core/management/__init__.py, django/core/management/base.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projTaskSystem = queue 'Task System' {
      technology 'Python'
      description 'Backend-agnostic task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projTemplateEngine 'renders views'
    projHttpHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projHttpHandler 'submits requests'
    projManagementCli -> projOrm 'manages schema/data'
    projManagementCli -> projHttpHandler 'runs development server'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending emails'
  }

  projGisService = external 'GeoSpatial Services' {
    technology 'GDAL, PROJ, GEOS'
    description 'External libraries for geographic data processing'
  }

  projEndUser -> projDjangoFramework.projHttpHandler 'accesses web app' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projManagementCli 'manages project' {
    technology 'Shell'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projHttpHandler -> projEmailService 'sends mail' {
    technology 'SMTP'
  }
  projDjangoFramework.projHttpHandler -> projGisService 'processes spatial data'
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestRunner = node 'Test Runner' {
      instanceOf projDjangoFramework.projManagementCli
    }
    projPostgresNode = node 'PostgreSQL Service' {
      instanceOf projDatabase
    }
    projTestRunner -> projPostgresNode 'runs migrations and tests'
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'Internal services and subsystems of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing pipeline within the HTTP Handler'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested in the GitHub Actions CI pipeline'
    include *
  }
}
model {
  projUser = actor 'Web User' {
    description 'A user accessing the web application'
  }

  projAdmin = actor 'System Administrator' {
    description 'Manages the Django application via the Admin interface'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains the Django framework and applications'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Web server interface for handling HTTP and WebSocket requests'
    }

    projDjangoApp = service 'Django Application' {
      technology 'Python 3.12+, Django'
      description 'The core application logic, handling routing, views, and business rules'

      projMiddleware = component 'Middleware Layer' {
        description 'Hooks into Django request/response processing'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions or classes'
      }

      projViewLayer = component 'View Layer' {
        description 'Processes requests and returns responses using templates or serializers'
      }

      projOrm = component 'Object-Relational Mapper (ORM)' {
        description 'Maps Python objects to database tables and handles queries'
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates, Jinja2'
        description 'Renders dynamic HTML content'
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewLayer 'calls view'
      projViewLayer -> projOrm 'queries data'
      projViewLayer -> projTemplateEngine 'renders UI'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Admin, JavaScript'
      description 'Built-in administrative interface for managing application data'
    }

    projMainDb = database 'Primary Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Relational database for persistent storage'
    }

    projCacheStore = cache 'Cache Layer' {
      technology 'Redis, Memcached'
      description 'Caching backend for performance optimization'
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Celery, Django Tasks'
      description 'Handles asynchronous background processing'
    }

    projWsgiServer -> projDjangoApp 'forwards requests'
    projDjangoApp -> projMainDb 'reads/writes' {
      technology 'SQL'
    }
    projDjangoApp -> projCacheStore 'caches data'
    projDjangoApp -> projTaskQueue 'enqueues jobs'
    projAdminInterface -> projDjangoApp 'uses'
  }

  projExternalAuth = external 'Auth Provider' {
    description 'External authentication services (OAuth, LDAP, etc.)'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'Sends system notifications and user emails'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'Amazon S3, WhiteNoise'
    description 'Hosts static assets and user-uploaded files'
  }

  projUser -> projDjangoFramework.projWsgiServer 'accesses site' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework 'contributes to'
  
  projDjangoFramework.projDjangoApp -> projExternalAuth 'authenticates users'
  projDjangoFramework.projDjangoApp -> projEmailService 'sends emails'
  projDjangoFramework.projDjangoApp -> projStaticStorage 'serves/stores files'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'The high-level technical building blocks of a Django-based system.'
    include *
  }

  view projectComponents of projDjangoFramework.projDjangoApp {
    title 'Components - Django Application'
    description 'Internal architecture of the Django application core.'
    include *
  }
}
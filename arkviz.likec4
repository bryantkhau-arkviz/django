specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Engine' {
        description 'Processes requests and responses globally'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'dispatches to'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for content management'
      metadata {
        sourceFiles 'django/contrib/admin/options.py, django/contrib/admin/sites.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projManagementCli = service 'Management CLI' {
      technology 'Python'
      description 'Command-line utility for administrative tasks'
      metadata {
        sourceFiles 'django/core/management/__init__.py, django/core/management/base.py'
      }
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projTemplateEngine 'renders views'
    projHttpHandler -> projAuthSystem 'authenticates users'
    projAdminInterface -> projHttpHandler 'uses'
    projManagementCli -> projOrm 'manages schema/migrations'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projCacheSystem = cache 'Cache Backend' {
    technology 'Redis, Memcached'
    description 'Provides high-performance data caching'
    metadata {
      sourceFiles 'django/core/cache/__init__.py'
    }
  }

  projEmailServer = external 'SMTP Server' {
    description 'Sends system emails'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projEndUser -> projDjangoFramework.projHttpHandler 'accesses web app' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projManagementCli 'runs commands'
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projHttpHandler -> projCacheSystem 'caches data'
  projDjangoFramework.projHttpHandler -> projEmailServer 'sends mail'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppServer = zone 'Application Server' {
      projWsgiNode = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projHttpHandler
      }
      projDjangoNode = node 'Django Instance' {
        instanceOf projDjangoFramework.projOrm
        instanceOf projDjangoFramework.projTemplateEngine
      }
    }
    projDbNode = node 'Managed Database' {
      instanceOf projDatabase
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core internal services and engines that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing pipeline within the Django HTTP Handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Setup'
    description 'Common deployment architecture for a Django-based application.'
    include *
  }
}
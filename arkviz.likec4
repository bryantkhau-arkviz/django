specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Django Developer' {
    description 'Develops and maintains applications using the Django framework'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Server' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the WSGI protocol'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/servers/basehttp.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'dispatches to'
    }

    projAsgiHandler = service 'ASGI Server' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests and protocols like WebSockets'
      metadata {
        sourceFiles 'django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projOrm = service 'ORM' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database interactions'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching backend for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin, JavaScript, CSS'
      description 'Automatic administrative interface for model management'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Background task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projAsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders views'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projWsgiHandler -> projTaskQueue 'triggers background jobs'
    projAdminInterface -> projWsgiHandler 'manages data'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database supported via django.contrib.postgres'
    metadata {
      sourceFiles 'django/contrib/postgres/operations.py'
    }
  }

  projSqlite = database 'SQLite' {
    technology 'SQLite'
    description 'Default lightweight database for development'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses web app' {
    technology 'HTTPS'
  }
  projUser -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework 'builds applications'
  projDjangoFramework.projOrm -> projPostgres 'persists data' {
    technology 'SQL'
  }
  projDjangoFramework.projOrm -> projSqlite 'persists data' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends notifications'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projWsgiHandler
        instanceOf projDjangoFramework.projAsgiHandler
      }
    }
    projDbZone = zone 'Database Tier' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projPostgres
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and systems within the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal components of the WSGI request handling pipeline.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Application'
    description 'Typical deployment architecture for a Django-based application.'
    include *
  }
}
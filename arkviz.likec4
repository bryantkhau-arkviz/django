specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'End User' {
    description 'A person who uses the application to view and manage data'
  }

  projAdmin = actor 'System Administrator' {
    description 'Manages the application via the Django admin interface'
  }

  projDjangoApp = system 'ArkViz Django Application' {
    description 'A web application built with the Django framework for data visualization and management'

    projWebFrontend = frontend 'Web Interface' {
      technology 'Django Templates, HTML, CSS, JavaScript'
      description 'The browser-based user interface rendered by Django'
      metadata {
        sourceFiles 'templates/base.html, templates/index.html'
      }
    }

    projDjangoServer = service 'Django Backend' {
      technology 'Python, Django'
      description 'The core application server handling business logic, routing, and data processing'
      metadata {
        sourceFiles 'manage.py, core/settings.py, core/wsgi.py'
      }

      projMiddleware = component 'Middleware' {
        description 'Processes requests and responses globally'
        metadata {
          sourceFiles 'core/middleware.py'
        }
      }

      projUrlConf = component 'URL Router' {
        description 'Maps incoming HTTP requests to the appropriate view functions'
        metadata {
          sourceFiles 'core/urls.py, app/urls.py'
        }
      }

      projViewLayer = component 'View Layer' {
        description 'Contains the business logic and handles request processing'
        metadata {
          sourceFiles 'app/views.py'
        }
      }

      projModelLayer = component 'Model Layer (ORM)' {
        description 'Defines the data structure and handles database interactions'
        metadata {
          sourceFiles 'app/models.py'
        }
      }

      projMiddleware -> projUrlConf 'passes request to'
      projUrlConf -> projViewLayer 'dispatches to'
      projViewLayer -> projModelLayer 'queries data via'
    }

    projDatabase = database 'PostgreSQL' {
      technology 'PostgreSQL'
      description 'Primary relational database for storing application data'
      metadata {
        sourceFiles 'core/settings.py'
      }
    }

    projCache = cache 'Redis Cache' {
      technology 'Redis'
      description 'In-memory data store for session management and query caching'
      metadata {
        sourceFiles 'core/settings.py'
      }
    }

    projTaskQueue = queue 'Celery Task Queue' {
      technology 'Celery, Redis'
      description 'Handles asynchronous background tasks'
      metadata {
        sourceFiles 'core/celery.py, app/tasks.py'
      }
    }

    projWebFrontend -> projDjangoServer 'sends requests to' {
      technology 'HTTP/HTTPS'
    }
    projDjangoServer -> projDatabase 'reads from and writes to' {
      technology 'SQL'
    }
    projDjangoServer -> projCache 'gets and sets values' {
      technology 'Redis Protocol'
    }
    projDjangoServer -> projTaskQueue 'enqueues tasks' {
      technology 'AMQP/Redis'
    }
  }

  projEmailService = external 'Email Provider' {
    description 'External service for sending transactional emails (e.g., SendGrid, Mailgun)'
  }

  projUser -> projDjangoApp.projWebFrontend 'uses' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoApp.projWebFrontend 'accesses admin panel' {
    technology 'HTTPS'
  }
  projDjangoApp.projDjangoServer -> projEmailService 'sends emails via' {
    technology 'SMTP/API'
  }
}

views {
  view projectContext {
    title 'System Context - ArkViz Django Application'
    description 'Overview of the system, its users, and external dependencies'
    include *
  }

  view projectContainers of projDjangoApp {
    title 'Containers - ArkViz Django Application'
    description 'The high-level technical building blocks of the Django application'
    include *
  }

  view projectComponents of projDjangoApp.projDjangoServer {
    title 'Components - Django Backend'
    description 'Internal architecture of the Django application server'
    include *
  }
}
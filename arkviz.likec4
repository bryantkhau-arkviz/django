specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'End User' {
    description 'A person interacting with the web application'
  }

  projAdmin = actor 'Site Administrator' {
    description 'A person managing the application via the Django Admin interface'
  }

  projDjangoSystem = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWebFrontend = frontend 'Web Interface' {
      technology 'HTML, CSS, JavaScript, Jinja'
      description 'The user-facing web interface rendered by Django templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/forms/renderers.py, django/views/generic/base.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAppServer = service 'Django Application Server' {
      technology 'Python, WSGI/ASGI'
      description 'The core application logic handling requests, middleware, and routing'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareStack = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/contrib/auth/middleware.py, django/middleware/csrf.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Processes requests and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projOrm = component 'Object-Relational Mapper (ORM)' {
        description 'Translates Python code into database queries'
        metadata {
          sourceFiles 'django/db/models/base.py, django/db/models/query.py'
        }
      }

      projAuthSystem = component 'Authentication System' {
        description 'Handles user accounts, groups, permissions and sessions'
        metadata {
          sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
        }
      }

      projTaskRunner = component 'Task Backend' {
        description 'Handles background task execution'
        metadata {
          sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
        }
      }

      projUrlResolver -> projMiddlewareStack 'routes to'
      projMiddlewareStack -> projViewEngine 'passes request to'
      projViewEngine -> projOrm 'queries data via'
      projViewEngine -> projAuthSystem 'authenticates via'
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL / SQLite / MySQL'
      description 'Stores application data, user accounts, and sessions'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheStore = cache 'Cache Store' {
      technology 'Redis / Memcached'
      description 'Caches frequently accessed data and session information'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projStaticFiles = service 'Static Files Storage' {
      technology 'File System / S3'
      description 'Serves CSS, JavaScript, and image files'
      metadata {
        sourceFiles 'django/contrib/staticfiles/storage.py'
      }
    }

    projWebFrontend -> projAppServer 'sends requests' {
      technology 'HTTP/HTTPS'
    }
    projAdminInterface -> projAppServer 'manages data' {
      technology 'HTTP/HTTPS'
    }
    projAppServer -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projAppServer -> projCacheStore 'gets/sets' {
      technology 'Cache Protocol'
    }
    projWebFrontend -> projStaticFiles 'fetches assets' {
      technology 'HTTP'
    }
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending notifications and password resets'
  }

  projUser -> projDjangoSystem.projWebFrontend 'uses' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoSystem.projAdminInterface 'administers' {
    technology 'HTTPS'
  }
  projDjangoSystem.projAppServer -> projEmailService 'sends emails' {
    technology 'SMTP'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'Gunicorn/Uvicorn Worker' {
        instanceOf projDjangoSystem.projAppServer
      }
    }
    projDataZone = zone 'Database Cluster' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projDjangoSystem.projDatabase
      }
      projCacheNode = node 'Managed Redis' {
        instanceOf projDjangoSystem.projCacheStore
      }
    }
    projStaticNode = node 'CDN / Nginx' {
      instanceOf projDjangoSystem.projStaticFiles
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django system and its actors'
    include *
  }

  view projectContainers of projDjangoSystem {
    title 'Containers - Django Web Framework'
    description 'The core containers of the Django architecture'
    include *
  }

  view projectComponents of projDjangoSystem.projAppServer {
    title 'Components - Django Application Server'
    description 'Internal architectural components of the Django App Server'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Production Environment'
    description 'Standard deployment architecture for a Django application'
    include *
  }
}
model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Django Developer' {
    description 'A developer building and maintaining Django applications'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI/ASGI'
      description 'Handles incoming HTTP requests via WSGI or ASGI interfaces'

      projMiddleware = component 'Middleware Layer' {
        description 'Hooks into Djangos request/response processing'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions'
      }
      projViewEngine = component 'View Engine' {
        description 'Processes logic and returns HTTP responses'
      }
      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django or Jinja2 templates'
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'routes to'
      projViewEngine -> projTemplateEngine 'uses for rendering'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database'
      description 'Pluggable caching system for performance optimization'
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Python'
      description 'Internal task execution and scheduling framework'
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projCacheSystem 'caches responses/data'
    projAdminInterface -> projHttpHandler 'uses'
    projHttpHandler -> projTaskQueue 'dispatches tasks'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database for data storage'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API based email delivery'
  }

  projUser -> projDjangoFramework.projHttpHandler 'accesses web apps' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projHttpHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and systems that make up the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal components of the Django HTTP request/response processing pipeline'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler (WSGI/ASGI)' {
      technology 'Python, ASGIRef'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projMiddleware = component 'Middleware Layer' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to views'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Processes logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQLParse'
      description 'Maps Python models to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Python, JavaScript, CSS'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/views.py, django/contrib/sessions/middleware.py'
      }
    }

    projCacheFramework = cache 'Cache Framework' {
      technology 'Python, Memcached/Redis/Database'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projAuthSystem 'authenticates users'
    projHttpHandler -> projCacheFramework 'caches responses'
    projAdminInterface -> projOrm 'manages data'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API based email delivery'
  }

  projPostgis = external 'PostGIS' {
    description 'Spatial database extender for PostgreSQL'
  }

  projDeveloper -> projDjangoFramework.projHttpHandler 'configures and develops'
  projEndUser -> projDjangoFramework.projHttpHandler 'accesses web apps' {
    technology 'HTTPS'
  }
  projDjangoFramework.projHttpHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgis 'spatial queries'
}

deployment {
  projCI = environment 'GitHub Actions CI' {
    projUbuntu = zone 'Ubuntu Runner' {
      projTestNode = node 'Test Runner' {
        instanceOf projDjangoFramework.projHttpHandler
      }
      projPostgresNode = node 'PostgreSQL Service' {
        instanceOf projDjangoFramework.projDatabase
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Major internal systems of the Django framework including ORM, Admin, and Auth'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing pipeline including Middleware, URL Routing, and Views'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested in GitHub Actions with PostgreSQL'
    include *
  }
}
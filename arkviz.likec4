specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing the web application built with Django'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and users via the Django Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Web server interface for running Django applications'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py'
      }
    }

    projDjangoCore = service 'Django Core' {
      technology 'Python, Django'
      description 'The core framework handling requests, routing, and responses'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/core/handlers/exception.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming URL patterns to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Processes requests and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projMiddlewareStack = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projOrm = component 'ORM (Object-Relational Mapper)' {
        description 'Maps database tables to Python classes'
        metadata {
          sourceFiles 'django/db/models/base.py, django/db/models/query.py'
        }
      }

      projUrlResolver -> projMiddlewareStack 'routes through'
      projMiddlewareStack -> projViewEngine 'executes'
      projViewEngine -> projOrm 'queries data'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projAdminApp = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'Built-in administration interface'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data and framework metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheStore = cache 'Cache Backend' {
      technology 'Redis, Memcached'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projWsgiServer -> projDjangoCore 'forwards requests' {
      technology 'WSGI/ASGI'
    }
    projDjangoCore -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projDjangoCore -> projCacheStore 'caches data'
    projAdminApp -> projDjangoCore 'uses'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'Sends system and user notifications'
  }

  projUser -> projDjangoFramework.projWsgiServer 'accesses application' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminApp 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projDjangoCore -> projEmailService 'sends emails' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Tier' {
      projAppNode = node 'App Server' {
        instanceOf projDjangoFramework.projWsgiServer
        instanceOf projDjangoFramework.projDjangoCore
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Database Server' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Cache Server' {
        instanceOf projDjangoFramework.projCacheStore
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its interactions'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal containers of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projDjangoCore {
    title 'Components - Django Core'
    description 'Internal architectural components of the Django Core service'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Framework'
    description 'Typical production deployment for a Django application'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains Django applications'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projRequestProcessor = component 'Request Processor' {
        description 'Processes raw environment data into HttpRequest objects'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/http/request.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Executes security, session, and common middleware'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewExecutor = component 'View Executor' {
        description 'Executes the business logic within views'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/contrib/admin/options.py'
        }
      }

      projRequestProcessor -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves URL'
      projUrlResolver -> projViewExecutor 'calls view'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database abstraction'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders HTML responses using templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskQueue = queue 'Task Backend' {
      technology 'Python'
      description 'Asynchronous task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders UI'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projWsgiHandler -> projTaskQueue 'triggers background tasks'
    projAdminInterface -> projWsgiHandler 'uses'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailProvider = external 'Email Service' {
    technology 'SMTP, API'
    description 'External service for sending emails'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'S3, Cloud Storage'
    description 'Stores static assets and user-uploaded files'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }

  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }

  projDjangoFramework.projWsgiHandler -> projEmailProvider 'sends notifications' {
    technology 'SMTP/HTTPS'
  }

  projDjangoFramework.projWsgiHandler -> projStaticStorage 'serves/uploads files' {
    technology 'HTTPS'
  }
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestNode = node 'Test Runner' {
      technology 'Ubuntu, Python 3.14'
      description 'Runs unit and integration tests'
    }
    projPostgresNode = node 'PostgreSQL Service' {
      technology 'PostgreSQL 15/18 Alpine'
      description 'Database for test execution'
    }
    projTestNode -> projPostgresNode 'connects for tests'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and subsystems of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal components of the request handling pipeline'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested in GitHub Actions'
    include *
  }
}
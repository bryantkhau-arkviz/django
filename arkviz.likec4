specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing the web application built with Django'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages the application via the Django Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiAsgi = service 'Request Handler (WSGI/ASGI)' {
      technology 'Python, asgiref'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projCoreEngine = service 'Django Core' {
      technology 'Python'
      description 'The core engine processing requests, routing, and middleware'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/core/handlers/exception.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a series of hooks (CSRF, Sessions, Auth)'
        metadata {
          sourceFiles 'django/middleware/csrf.py, django/contrib/sessions/middleware.py, django/contrib/auth/middleware.py'
        }
      }

      projViewProcessor = component 'View Processor' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewProcessor 'invokes'
      projViewProcessor -> projTemplateEngine 'renders with'
    }

    projOrm = service 'Django ORM' {
      technology 'Python, sqlparse'
      description 'Object-Relational Mapper for database interactions'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, JavaScript, CSS'
      description 'Automatic administrative interface for site management'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDb = database 'Relational Database' {
      technology 'PostgreSQL/MySQL/SQLite'
      description 'Stores application data and metadata'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py'
      }
    }

    projCache = cache 'Cache Layer' {
      technology 'Redis/Memcached'
      description 'Pluggable caching backend for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projWsgiAsgi -> projCoreEngine 'forwards requests'
    projCoreEngine -> projOrm 'queries data'
    projCoreEngine -> projCache 'accesses cached data'
    projOrm -> projDb 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projCoreEngine 'uses'
  }

  projEmailService = external 'Email Server' {
    description 'External SMTP or API service for sending emails'
  }

  projUser -> projDjangoFramework.projWsgiAsgi 'accesses site' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projCoreEngine -> projEmailService 'sends mail' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Tier' {
      projWebServer = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projWsgiAsgi
      }
      projAppServer = node 'Django Application' {
        instanceOf projDjangoFramework.projCoreEngine
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'PostgreSQL Cluster' {
        instanceOf projDjangoFramework.projDb
      }
      projCacheNode = node 'Redis Cluster' {
        instanceOf projDjangoFramework.projCache
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its interactions'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core containers of the Django framework including ORM, Admin, and Core Engine'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreEngine {
    title 'Components - Django Core Engine'
    description 'Internal architectural components of the Django Core service'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Production'
    description 'Typical production deployment for a Django-based application'
    include *
  }
}
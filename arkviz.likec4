model {
  projDeveloper = actor 'Developer' {
    description 'Builds web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built with Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin, HTML, CSS, JavaScript'
      description 'Automatic administrative interface for managing application data'
    }

    projCoreHandler = service 'Core Request Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Processes incoming HTTP requests and routes them to appropriate views'

      projMiddleware = component 'Middleware Layer' {
        description 'Hooks into request/response processing (Security, CSRF, Sessions)'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions or classes'
      }
      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
      }
      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django Templates or Jinja2'
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'routes to'
      projViewEngine -> projTemplateEngine 'uses for rendering'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps Python classes to database tables and handles migrations'
    }

    projPostgresDb = database 'PostgreSQL' {
      technology 'PostgreSQL'
      description 'Relational database for persistent storage'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis / Memcached'
      description 'Pluggable caching backend for performance optimization'
    }

    projTaskQueue = queue 'Task Backend' {
      technology 'Django Tasks'
      description 'Asynchronous task execution and background processing'
    }

    projAdminInterface -> projCoreHandler 'submits management requests'
    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCacheSystem 'reads/writes cached data'
    projCoreHandler -> projTaskQueue 'enqueues background jobs'
    projOrm -> projPostgresDb 'executes SQL' {
      technology 'psycopg'
    }
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP / SendGrid'
    description 'External service for sending notifications and alerts'
  }

  projTrac = external 'Trac' {
    description 'Issue tracking system for Django development'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'configures and manages data'
  projDeveloper -> projTrac 'reports bugs and tracks features'
  projEndUser -> projDjangoFramework.projCoreHandler 'accesses web application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projCoreHandler -> projEmailService 'sends emails' {
    technology 'SMTP'
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'Overview of the Django framework, its users, and external integrations'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'The high-level building blocks of the Django framework architecture'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Core Request Handler'
    description 'Internal request processing pipeline within the Django core handler'
    include *
  }
}
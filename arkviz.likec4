specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Django Developer' {
    description 'A developer using the Django framework to build and test applications'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the WSGI standard'
      
      projMiddleware = component 'Middleware Stack' {
        description 'Chain of components processing requests and responses (Security, CSRF, Session, etc.)'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
      }
      projViewProcessor = component 'View Processor' {
        description 'Executes business logic and returns HTTP responses'
      }
      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django or Jinja2 templates'
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewProcessor 'dispatches to'
      projViewProcessor -> projTemplateEngine 'uses for rendering'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests and protocols like WebSockets'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing application data'
    }

    projOrm = service 'ORM / Database Layer' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching backend for performance optimization'
    }

    projTaskSystem = queue 'Tasks / Background Jobs' {
      technology 'Django Tasks'
      description 'Internal task execution system for background processing'
    }

    projStaticFiles = service 'Static Files Handler' {
      technology 'Python'
      description 'Manages and serves CSS, JavaScript, and images'
    }

    projWsgiHandler -> projOrm 'queries data'
    projAsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCacheSystem 'reads/writes'
    projWsgiHandler -> projTaskSystem 'enqueues jobs'
    projAdminInterface -> projWsgiHandler 'calls'
    projOrm -> projCacheSystem 'uses for query caching'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Primary persistent storage for application data'
  }

  projExternalEmail = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending notifications and system emails'
  }

  projGisService = external 'Geospatial Services' {
    technology 'PostGIS, GDAL'
    description 'External libraries and databases for geographic data'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses app' {
    technology 'HTTPS'
  }
  projUser -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework 'develops and tests'
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projExternalEmail 'sends mail'
  projDjangoFramework.projOrm -> projGisService 'uses for GIS'
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and components of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing pipeline within the WSGI Handler'
    include *
  }
}
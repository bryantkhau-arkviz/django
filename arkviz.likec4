specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-powered web application'
  }

  projDeveloper = actor 'Django Developer' {
    description 'Develops and maintains applications using the Django framework'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system.'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Engine' {
        description 'Processes requests and responses globally (Security, CSRF, Sessions, Auth).'
        metadata {
          sourceFiles 'django/middleware/security.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py, django/contrib/auth/middleware.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes.'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses.'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py, django/views/generic/edit.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2.'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'dispatches to'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles queries.'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminApp = service 'Admin Interface' {
      technology 'Python, HTML, JS'
      description 'Automatic administrative interface for managing site content.'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database, Local Memory'
      description 'Pluggable caching system to improve performance.'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Python'
      description 'Asynchronous task execution framework.'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projManagementCli = service 'Management CLI' {
      technology 'Python'
      description 'Command-line interface for administrative tasks (migrations, shell, etc.).'
      metadata {
        sourceFiles 'django/core/management/__init__.py, django/core/management/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data' {
      technology 'Python API'
    }
    projWsgiHandler -> projCacheSystem 'gets/sets data' {
      technology 'Python API'
    }
    projAdminApp -> projOrm 'manages models' {
      technology 'Python API'
    }
    projManagementCli -> projOrm 'runs migrations' {
      technology 'SQL'
    }
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database used in tests and benchmarks.'
  }

  projEmailService = external 'Email Server' {
    technology 'SMTP'
    description 'External service for sending notifications and password resets.'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses web app' {
    technology 'HTTPS'
  }
  projUser -> projDjangoFramework.projAdminApp 'manages content' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projManagementCli 'manages application' {
    technology 'Shell'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends emails' {
    technology 'SMTP'
  }
}

deployment {
  projCiEnv = environment 'GitHub Actions' {
    projUbuntuNode = node 'Ubuntu Runner' {
      projPostgresNode = node 'PostgreSQL Container' {
        instanceOf projPostgres
      }
      projDjangoNode = node 'Django Test Runner' {
        instanceOf projDjangoFramework.projWsgiHandler
        instanceOf projDjangoFramework.projOrm
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and data stores within the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal modules responsible for request processing and response generation.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI/CD Environment'
    description 'How Django is tested within GitHub Actions using PostgreSQL.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpServer = service 'HTTP Server' {
      technology 'WSGI/ASGI, Gunicorn, Daphne'
      description 'Handles incoming HTTP requests and routes them to the application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/servers/basehttp.py'
      }

      projRequestProcessor = component 'Request Processor' {
        description 'Converts raw WSGI/ASGI environments into HttpRequest objects'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/http/request.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a series of hooks'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions or classes'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewHandler = component 'View Handler' {
        description 'Executes business logic and returns HttpResponse objects'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projRequestProcessor -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves URL'
      projUrlResolver -> projViewHandler 'dispatches to view'
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python, SQL'
      description 'Maps Python classes to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using context data'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/base.py, django/template/backends/django.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Contrib Admin'
      description 'Automatic administrative interface for managing model data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Internal task management and background processing'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projHttpServer -> projOrm 'queries data'
    projHttpServer -> projTemplateEngine 'renders views'
    projHttpServer -> projCacheSystem 'caches responses'
    projHttpServer -> projTaskQueue 'enqueues background jobs'
    projOrm -> projDatabase 'executes SQL'
    projAdminInterface -> projHttpServer 'calls internal APIs'
  }

  projExternalAuth = external 'Auth Providers' {
    description 'External OAuth/OpenID Connect providers (e.g., Google, GitHub)'
  }

  projEmailService = external 'Email Service' {
    description 'SMTP servers or API-based email providers (e.g., SendGrid, Mailgun)'
  }

  projEndUser -> projDjangoFramework.projHttpServer 'accesses web app' {
    technology 'HTTPS'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }

  projDjangoFramework.projHttpServer -> projExternalAuth 'authenticates users' {
    technology 'OAuth 2.0'
  }

  projDjangoFramework.projHttpServer -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projCloudZone = zone 'Cloud Provider' {
      projAppNode = node 'Application Server' {
        instanceOf projDjangoFramework.projHttpServer
      }
      projDbNode = node 'Managed Database' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Managed Redis' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework and its interactions with users and external systems.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and data stores of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpServer {
    title 'Components - HTTP Server'
    description 'Internal request processing pipeline within the Django HTTP handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Production Environment'
    description 'Typical production deployment of a Django application.'
    include *
  }
}
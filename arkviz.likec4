specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Django request/response processing for security, sessions, and CSRF'
        metadata {
          sourceFiles 'django/middleware/security.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewSystem = component 'View System' {
        description 'Processes requests and returns responses using generic or functional views'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/defaults.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewSystem 'calls view'
      projViewSystem -> projTemplateEngine 'renders'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Translates Python model definitions into database schemas and queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Python, JavaScript, CSS'
      description 'Automatic administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions and cookie-based user sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Asynchronous task execution and background processing'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data and Django metadata'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py, django/db/backends/sqlite3/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projAdminInterface -> projOrm 'manages models'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projWsgiHandler -> projTaskSystem 'triggers background jobs'
  }

  projExternalMail = external 'Email Service' {
    description 'SMTP or API-based email delivery'
  }

  projExternalCache = cache 'Cache Store' {
    technology 'Redis, Memcached'
    description 'Distributed memory object caching system'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'configures and manages data' {
    technology 'HTTPS'
  }
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses web application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projExternalMail 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projExternalCache 'caches responses/data' {
    technology 'Redis Protocol'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Server' {
      projWebNode = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
      projAdminNode = node 'Django Admin' {
        instanceOf projDjangoFramework.projAdminInterface
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Managed Redis' {
        instanceOf projExternalCache
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural components of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard deployment architecture for a Django-based application.'
    include *
  }
}
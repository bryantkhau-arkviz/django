specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-based web application'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and users via the Django Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system.'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing for security, sessions, and common tasks.'
        metadata {
          sourceFiles 'django/middleware/security.py, django/middleware/csrf.py, django/middleware/sessions.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes.'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewSystem = component 'View System' {
        description 'Processes requests and returns HTTP responses, often using templates.'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML or other formats using Django or Jinja2 templates.'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewSystem 'calls view'
      projViewSystem -> projTemplateEngine 'renders'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Provides an abstraction layer for database operations using Python models.'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'A built-in, automated administrative interface for managing application data.'
      metadata {
        sourceFiles 'django/contrib/admin/options.py, django/contrib/admin/sites.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and groups.'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database'
      description 'A robust cache system for storing expensive computations or database results.'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data, user accounts, and sessions.'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheSystem 'reads/writes cache'
    projAdminInterface -> projOrm 'manages data'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
  }

  projExternalMail = external 'Email Service' {
    description 'External SMTP or API-based email delivery service'
  }

  projDjangoFramework.projWsgiHandler -> projExternalMail 'sends emails' {
    technology 'SMTP/HTTPS'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }

  projAdmin -> projDjangoFramework.projAdminInterface 'manages site' {
    technology 'HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projWebServer = node 'Web Server (Gunicorn/Uvicorn)' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
    }
    projDataZone = zone 'Database Cluster' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projDjangoFramework.projDatabase
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its interactions with users and external systems.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and data stores that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - Request Handler'
    description 'Internal components of the WSGI/ASGI request handling pipeline.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Setup'
    description 'Standard deployment architecture for a Django application.'
    include *
  }
}
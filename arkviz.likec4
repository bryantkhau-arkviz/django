specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A person interacting with the Django-based web application'
  }

  projAdmin = actor 'System Administrator' {
    description 'Manages the application via the Django Admin interface'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, or Daphne'
      description 'The web server interface that handles incoming HTTP/WebSocket requests and forwards them to the application.'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/servers/basehttp.py'
      }
    }

    projAppServer = service 'Django Application Server' {
      technology 'Python, Django'
      description 'The core application logic, including routing, middleware, and view processing.'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/conf/__init__.py, django/apps/registry.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming request URLs to the appropriate view functions or classes.'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses globally (e.g., CSRF, Authentication, Sessions).'
        metadata {
          sourceFiles 'django/middleware/csrf.py, django/contrib/sessions/middleware.py, django/contrib/auth/middleware.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses, often using templates.'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/template/engine.py'
        }
      }

      projOrm = component 'ORM (Object-Relational Mapper)' {
        description 'Translates Python model definitions into database queries.'
        metadata {
          sourceFiles 'django/db/models/base.py, django/db/models/query.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'executes'
      projViewEngine -> projOrm 'queries data via'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'The built-in administrative interface for managing application data.'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, or Oracle'
      description 'Stores application data, user accounts, and session information.'
      metadata {
        sourceFiles 'django/db/backends/base/base.py'
      }
    }

    projCacheStore = cache 'Cache Backend' {
      technology 'Redis or Memcached'
      description 'Stores frequently accessed data to improve performance.'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Handles asynchronous background processing.'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projWsgiServer -> projAppServer 'forwards requests' {
      technology 'WSGI/ASGI'
    }
    projAppServer -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projAppServer -> projCacheStore 'caches data'
    projAppServer -> projTaskQueue 'enqueues jobs'
    projAdminInterface -> projAppServer 'uses' {
      technology 'HTTPS'
    }
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP / SendGrid / Mailgun'
    description 'Sends system notifications and user emails.'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'AWS S3 / Cloud Storage'
    description 'Hosts static assets and user-uploaded files.'
  }

  projUser -> projDjangoFramework.projWsgiServer 'accesses application' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDjangoFramework.projAppServer -> projEmailService 'sends emails' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projAppServer -> projStaticStorage 'stores/retrieves files' {
    technology 'Boto3/HTTPS'
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'Internal services, databases, and interfaces of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projAppServer {
    title 'Components - Django Application Server'
    description 'Internal architectural components of the core Django application server.'
    include *
  }
}
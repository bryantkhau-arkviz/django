specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Uses Django to build web applications'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with applications built using Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the WSGI protocol'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/base.py'
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a series of hooks'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddlewareChain -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGI, asgiref'
      description 'Handles asynchronous web requests and protocols like WebSockets'
      metadata {
        sourceFiles 'django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions, and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projCacheFramework = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Python'
      description 'Asynchronous task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projAsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheFramework 'caches responses'
    projAdminInterface -> projWsgiHandler 'uses'
    projOrm -> projDatabase 'executes SQL'
    projWsgiHandler -> projTaskQueue 'enqueues tasks'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API service for sending emails'
  }

  projGisService = external 'GIS Services' {
    description 'Geospatial data services (PostGIS, GDAL, PROJ)'
  }

  projDeveloper -> projDjangoFramework 'builds apps with'
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses web pages' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projOrm -> projGisService 'uses spatial functions'
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestNode = node 'Test Runner' {
      instanceOf projDjangoFramework.projWsgiHandler
    }
    projPostgresNode = node 'PostgreSQL Service' {
      instanceOf projDjangoFramework.projDatabase
    }
    projTestNode -> projPostgresNode 'runs tests against'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and data stores of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing components within the WSGI Handler'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested in GitHub Actions'
    include *
  }
}
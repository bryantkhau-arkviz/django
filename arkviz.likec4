specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A person accessing a website built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'A software engineer using Django to build and manage web applications'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the Web Server Gateway Interface'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/servers/basehttp.py'
      }

      projMiddlewareEngine = component 'Middleware Engine' {
        description 'Processes requests and responses through a chain of middleware'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/middleware/common.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewProcessor = component 'View Processor' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML content using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddlewareEngine -> projUrlResolver 'resolves path'
      projUrlResolver -> projViewProcessor 'calls view'
      projViewProcessor -> projTemplateEngine 'renders'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGI, asgiref'
      description 'Handles asynchronous web requests via the Asynchronous Server Gateway Interface'
      metadata {
        sourceFiles 'django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps Python objects to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, CSS, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projManagementCli = service 'Management CLI' {
      technology 'Python'
      description 'Command-line utility for administrative tasks (django-admin, manage.py)'
      metadata {
        sourceFiles 'django/core/management/__init__.py, django/core/management/base.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system to improve performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskBackend = queue 'Tasks Backend' {
      technology 'Python'
      description 'Pluggable backend for background task execution'
      metadata {
        sourceFiles 'django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projAsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCacheSystem 'reads/writes cache'
    projAdminInterface -> projWsgiHandler 'uses'
    projWsgiHandler -> projTaskBackend 'enqueues tasks'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending emails'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses web pages' {
    technology 'HTTPS'
  }

  projDeveloper -> projDjangoFramework.projManagementCli 'manages application' {
    technology 'Shell'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }

  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }

  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Tier' {
      projWebServer = node 'Web Server (Gunicorn/Uvicorn)' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
      projAsyncServer = node 'ASGI Server (Daphne/Uvicorn)' {
        instanceOf projDjangoFramework.projAsgiHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database (RDS/Cloud SQL)' {
        instanceOf projDatabase
      }
      projCacheNode = node 'Managed Cache (ElastiCache/Redis)' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal services and architectural building blocks of Django.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing pipeline within the WSGI Handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard deployment architecture for a Django application.'
    include *
  }
}
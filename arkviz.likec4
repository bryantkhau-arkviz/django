specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming HTTP requests via WSGI or ASGI interfaces'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Engine' {
        description 'Processes requests and responses through a chain of middleware'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'dispatches to'
    }

    projOrm = service 'ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, CSS, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Background task execution and scheduling framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projAuthSystem = service 'Auth System' {
      technology 'Python'
      description 'Authentication and authorization framework'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/auth/middleware.py'
      }
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projTemplateEngine 'renders views'
    projHttpHandler -> projCacheSystem 'caches responses'
    projHttpHandler -> projAuthSystem 'authenticates users'
    projHttpHandler -> projTaskSystem 'triggers background jobs'
    projAdminInterface -> projHttpHandler 'uses'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'Sends system notifications and user emails'
  }

  projDeveloper -> projDjangoFramework 'develops with'
  projEndUser -> projDjangoFramework.projHttpHandler 'accesses apps' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework -> projEmailService 'sends mail' {
    technology 'SMTP'
  }
}

deployment {
  projCI = environment 'GitHub Actions' {
    projUbuntu = zone 'Ubuntu Latest' {
      projPostgresNode = node 'PostgreSQL Service' {
        instanceOf projDatabase
      }
      projTestRunner = node 'Python Test Runner' {
        instanceOf projDjangoFramework.projHttpHandler
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Core subsystems of the Django framework including ORM, Templates, and Admin.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing pipeline within the Django HTTP Handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested within GitHub Actions infrastructure.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI/ASGI'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a series of hooks'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py, django/views/generic/edit.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML content using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'invokes'
      projViewEngine -> projTemplateEngine 'renders with'
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Python, HTML/JS'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions, and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data and framework metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheSystem = cache 'Cache System' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching framework for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projAuthSystem 'authenticates users'
    projHttpHandler -> projCacheSystem 'caches responses'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projHttpHandler 'uses'
    projAdminInterface -> projOrm 'manages models'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API service for sending emails'
  }

  projGisService = external 'GIS Backend' {
    technology 'PostGIS, GDAL'
    description 'Geospatial database extensions and libraries'
  }

  projDeveloper -> projDjangoFramework 'configures and extends' {
    technology 'Python'
  }
  projEndUser -> projDjangoFramework.projHttpHandler 'sends requests' {
    technology 'HTTPS'
  }
  projDjangoFramework.projHttpHandler -> projEmailService 'sends mail' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projOrm -> projGisService 'performs spatial queries'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Tier' {
      projWebServer = node 'Web Server (Gunicorn/Uvicorn)' {
        instanceOf projDjangoFramework.projHttpHandler
      }
      projAdminNode = node 'Admin Service' {
        instanceOf projDjangoFramework.projAdminInterface
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database (RDS/Cloud SQL)' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Managed Cache (ElastiCache/MemoryStore)' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural building blocks of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing pipeline within the Django HTTP handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard deployment architecture for a Django-based application.'
    include *
  }
}
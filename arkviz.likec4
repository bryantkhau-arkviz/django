specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-powered application'
  }

  projAdmin = actor 'System Administrator' {
    description 'Manages the application via the Django Admin interface'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains the Django application and its infrastructure'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, asgiref'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a series of hooks (Security, CSRF, Session, etc.)'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'calls'
      projViewEngine -> projTemplateEngine 'renders with'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, sqlparse'
      description 'Provides an abstraction layer for database operations'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript, CSS'
      description 'Built-in administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthService = service 'Authentication System' {
      technology 'Python, argon2, bcrypt'
      description 'Handles user authentication, permissions, and session management'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Handles asynchronous background tasks'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, or Oracle'
      description 'Stores application data, user accounts, and sessions'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py'
      }
    }

    projCache = cache 'Cache Layer' {
      technology 'Redis, Memcached, or Local Memory'
      description 'Caches frequently accessed data and template fragments'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthService 'authenticates users'
    projWsgiHandler -> projCache 'reads/writes cache'
    projWsgiHandler -> projTaskQueue 'enqueues tasks'
    projAdminInterface -> projWsgiHandler 'calls'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAuthService -> projOrm 'persists users'
  }

  projEmailProvider = external 'Email Service' {
    description 'External SMTP or API-based email delivery service'
  }

  projStaticStorage = external 'Static/Media Storage' {
    description 'Cloud storage for static files and user uploads (e.g., S3)'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework 'configures and deploys'
  projDjangoFramework.projWsgiHandler -> projEmailProvider 'sends emails' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projStaticStorage 'serves/uploads files'
}

deployment {
  projCI = environment 'GitHub Actions CI' {
    projTestNode = node 'Test Runner' {
      description 'Runs Django test suite across multiple Python/Database versions'
      instanceOf projDjangoFramework.projWsgiHandler
    }
    projPostgresNode = node 'PostgreSQL Service' {
      instanceOf projDjangoFramework.projDatabase
    }
    projTestNode -> projPostgresNode 'runs migrations and tests'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural components of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - Request Handler'
    description 'Internal request processing pipeline within Django.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested within GitHub Actions infrastructure.'
    include *
  }
}
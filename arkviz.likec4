model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projDeveloper = actor 'Django Developer' {
    description 'Develops and maintains applications using the Django framework'
  }

  projDjango = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn'
      description 'Web server interface for handling synchronous and asynchronous requests'
    }

    projCoreHandler = service 'Django Core Handler' {
      technology 'Python'
      description 'The core request/response processing engine'

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming URL patterns to the appropriate view functions'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into request/response processing (CSRF, Sessions, Auth)'
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates, Jinja2'
        description 'Renders dynamic HTML content'
      }

      projUrlResolver -> projMiddleware 'routes request through'
      projMiddleware -> projViewEngine 'passes processed request'
      projViewEngine -> projTemplateEngine 'requests rendering'
    }

    projOrm = service 'Django ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction'

      projQuerySet = component 'QuerySet API' {
        description 'Interface for building and executing database queries'
      }

      projMigrationEngine = component 'Migration Engine' {
        description 'Manages database schema versioning and updates'
      }

      projQuerySet -> projMigrationEngine 'validates schema against'
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite'
      description 'Primary persistent data store'
    }

    projCache = cache 'Cache Backend' {
      technology 'Redis, Memcached'
      description 'Pluggable caching system for performance optimization'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for site management'
    }

    projWsgiServer -> projCoreHandler 'forwards requests' {
      technology 'WSGI/ASGI'
    }
    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCache 'reads/writes cached data'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projCoreHandler 'uses for data management'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid'
    description 'External service for sending notifications and system emails'
  }

  projGithubActions = external 'GitHub Actions' {
    technology 'YAML'
    description 'CI/CD platform for running tests, linters, and benchmarks'
  }

  projUser -> projDjango.projWsgiServer 'accesses application' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjango.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDeveloper -> projGithubActions 'pushes code' {
    technology 'Git'
  }
  projDjango.projCoreHandler -> projEmailService 'sends emails' {
    technology 'SMTP'
  }
  projGithubActions -> projDjango 'runs tests and benchmarks'
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjango {
    title 'Containers - Django Architecture'
    description 'The internal services and data stores that make up the Django framework'
    include *
  }

  view projectComponents of projDjango.projCoreHandler {
    title 'Components - Django Core Handler'
    description 'Internal modules within the core request/response processing engine'
    include *
  }
}
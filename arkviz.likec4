model {
  projDeveloper = actor 'Developer' {
    description 'A developer contributing to or using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'A user of a web application built with Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, asgiref'
      description 'The entry point for web servers to communicate with the Django application.'

      projRequestFactory = component 'Request Factory' {
        description 'Creates WSGIRequest or ASGIRequest objects from environment data'
      }
      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a configurable stack of middleware'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes'
      }
      projViewProcessor = component 'View Processor' {
        description 'Executes the business logic for a specific request and returns a response'
      }

      projRequestFactory -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves path'
      projUrlResolver -> projViewProcessor 'dispatches to view'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'A built-in, automated administrative interface for managing application data.'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps Python classes to database tables and provides a high-level API for data manipulation.'
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using templates and context data.'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable cache backends for improving performance.'
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'The primary data store for the application.'
    }

    projTaskQueue = queue 'Background Tasks' {
      technology 'Django Tasks API'
      description 'Handles asynchronous task execution.'
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders views'
    projWsgiHandler -> projCacheSystem 'reads/writes cache'
    projOrm -> projDatabase 'executes SQL'
    projAdminInterface -> projWsgiHandler 'calls admin views'
    projWsgiHandler -> projTaskQueue 'enqueues tasks'
  }

  projWebBrowser = external 'Web Browser' {
    description 'The client used by end users to access Django applications.'
  }

  projEmailServer = external 'SMTP Server' {
    description 'External service for sending emails.'
  }

  projTrac = external 'Trac' {
    description 'The issue tracking system used by the Django project.'
  }

  projDeveloper -> projDjangoFramework 'contributes code and uses framework'
  projEndUser -> projWebBrowser 'interacts with'
  projWebBrowser -> projDjangoFramework.projWsgiHandler 'sends HTTP requests' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projEmailServer 'sends emails' {
    technology 'SMTP'
  }
  projDeveloper -> projTrac 'reports and tracks issues'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'The high-level technical building blocks of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - Request Handling'
    description 'Internal components within the WSGI/ASGI Handler service.'
    include *
  }
}
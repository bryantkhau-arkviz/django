model {
  projDeveloper = actor 'Developer' {
    description 'Software engineer developing or contributing to the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'User of a web application built with the Django framework'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the Web Server Gateway Interface'

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions'
      }
      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns responses'
      }
      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2'
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'dispatches to'
      projViewEngine -> projTemplateEngine 'uses for rendering'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests via the Asynchronous Server Gateway Interface'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing application data'
    }

    projOrm = service 'ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database'
      description 'Pluggable caching framework for performance optimization'
    }

    projTaskSystem = queue 'Task System' {
      technology 'Python'
      description 'Internal task execution and signal dispatching'
    }

    projDatabase = database 'Primary Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Relational database for persistent storage'
    }

    projWsgiHandler -> projOrm 'queries data'
    projAsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCacheSystem 'reads/writes'
    projAdminInterface -> projWsgiHandler 'uses'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
  }

  projGithubActions = external 'GitHub Actions' {
    description 'CI/CD platform for running benchmarks, tests, and linters'
  }

  projTrac = external 'Trac' {
    description 'Issue tracking system for the Django project'
  }

  projPyPi = external 'PyPI' {
    description 'Python Package Index for distributing the framework'
  }

  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses app' {
    technology 'HTTPS'
  }
  projEndUser -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDeveloper -> projGithubActions 'triggers workflows'
  projDeveloper -> projTrac 'reports bugs'
  projGithubActions -> projDjangoFramework 'tests and builds'
  projDjangoFramework -> projPyPi 'published to'
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external ecosystem'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal architecture of the Django framework showing core handlers and subsystems'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal components of the WSGI request handling pipeline'
    include *
  }
}
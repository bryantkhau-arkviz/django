specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCoreHandler = service 'Core Request Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Processes incoming HTTP requests and returns responses'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/core/handlers/wsgi.py, django/core/handlers/asgi.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Hooks into the request/response processing for security, sessions, and more'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django Template Language or Jinja2'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'processes through'
      projViewEngine -> projTemplateEngine 'renders via'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskQueue = queue 'Task Backend' {
      technology 'Python'
      description 'Asynchronous task execution and background processing'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCacheSystem 'caches responses/data'
    projCoreHandler -> projTaskQueue 'triggers background jobs'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projCoreHandler 'uses'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery'
  }

  projGisService = external 'GIS Libraries' {
    technology 'GDAL, PROJ, GEOS'
    description 'Geospatial data processing libraries'
  }

  projDjangoFramework.projCoreHandler -> projEmailService 'sends mail' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projOrm -> projGisService 'processes spatial data'

  projDeveloper -> projDjangoFramework 'develops with'
  projEndUser -> projDjangoFramework.projAdminInterface 'manages data'
  projEndUser -> projDjangoFramework.projCoreHandler 'accesses web apps' {
    technology 'HTTPS'
  }
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestNode = node 'Ubuntu Runner' {
      projPostgresNode = node 'PostgreSQL Service' {
        instanceOf projDjangoFramework.projDatabase
      }
      projAppNode = node 'Python 3.14 Environment' {
        instanceOf projDjangoFramework.projCoreHandler
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The high-level building blocks of the Django framework including the ORM, Handlers, and Admin.'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Core Request Handler'
    description 'Internal request processing pipeline including URL routing, Middleware, and Views.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI/CD Test Environment'
    description 'How Django is tested within GitHub Actions using PostgreSQL.'
    include *
  }
}
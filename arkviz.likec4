model {
  projUser = actor 'Web User' {
    description 'A user accessing a web application built with Django'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and users via the Django Admin interface'
  }

  projDeveloper = actor 'Software Developer' {
    description 'Develops and maintains applications using the Django framework'
  }

  projDjango = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Web server interface for handling synchronous (WSGI) and asynchronous (ASGI) requests'
    }

    projCoreHandler = service 'Django Core Handler' {
      technology 'Python'
      description 'The heart of Django that processes requests, manages middleware, and routes to views'

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing (Security, Session, Auth, CSRF)'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes'
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and interacts with models and templates'
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates, Jinja2'
        description 'Renders dynamic HTML content using context data'
      }

      projMiddleware -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'routes to'
      projViewEngine -> projTemplateEngine 'renders with'
    }

    projOrm = service 'Django ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for interacting with databases using Python objects'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript, CSS'
      description 'Built-in administrative interface for managing application data'
    }

    projStaticFiles = service 'Static Files Handler' {
      technology 'django.contrib.staticfiles'
      description 'Manages and serves CSS, JavaScript, and image assets'
    }

    projCache = cache 'Cache Framework' {
      technology 'Redis, Memcached'
      description 'Pluggable caching backend for performance optimization'
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Primary persistent data store for application models'
    }

    projTaskQueue = queue 'Django Tasks' {
      technology 'django.tasks (Experimental)'
      description 'Background task execution and scheduling'
    }

    projWsgiServer -> projCoreHandler 'forwards requests' {
      technology 'WSGI/ASGI'
    }
    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCache 'reads/writes'
    projCoreHandler -> projTaskQueue 'enqueues jobs'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projCoreHandler 'uses'
    projStaticFiles -> projWsgiServer 'serves assets through'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'External service for sending transactional emails'
  }

  projGeoService = external 'GIS Services' {
    technology 'PostGIS, GDAL'
    description 'Geospatial data processing and storage'
  }

  projUser -> projDjango.projWsgiServer 'accesses application' {
    technology 'HTTPS'
  }
  projAdmin -> projDjango.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjango 'configures and extends'
  projDjango.projCoreHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
  projDjango.projOrm -> projGeoService 'interacts with' {
    technology 'SQL/C Libraries'
  }
}

views {
  view projProjectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projProjectContainers of projDjango {
    title 'Containers - Django Web Framework'
    description 'The internal architecture of the Django framework'
    include *
  }

  view projProjectComponents of projDjango.projCoreHandler {
    title 'Components - Django Core Handler'
    description 'Internal request processing components within the Django Core'
    include *
  }
}
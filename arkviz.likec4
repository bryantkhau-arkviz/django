specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-based web application'
  }

  projAdmin = actor 'System Administrator' {
    description 'Manages the Django application via the built-in Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Stack' {
        technology 'Python'
        description 'Hooks into Django request/response processing for security, sessions, and common tasks'
        metadata {
          sourceFiles 'django/middleware/security.py, django/middleware/csrf.py, django/contrib/sessions/middleware.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        technology 'Python'
        description 'Maps requested URLs to the appropriate view functions or classes'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewSystem = component 'View System' {
        technology 'Python'
        description 'Processes requests and returns responses using generic or custom logic'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py, django/contrib/admin/options.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Django Templates, Jinja2'
        description 'Renders dynamic HTML content using templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewSystem 'dispatches to'
      projViewSystem -> projTemplateEngine 'renders'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Provides an abstraction layer for database operations using Python models'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projDb = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data and metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCache = cache 'Cache System' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching framework for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin, JavaScript, CSS'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projOrm -> projDb 'executes SQL' {
      technology 'SQL'
    }
    projWsgiHandler -> projCache 'accesses'
    projAdminInterface -> projWsgiHandler 'calls' {
      technology 'HTTP'
    }
  }

  projEmailServer = external 'Email Server' {
    technology 'SMTP'
    description 'External service for sending notifications and password resets'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'interacts with' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projEmailServer 'sends emails' {
    technology 'SMTP'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Server' {
      projAppNode = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
    }
    projDbZone = zone 'Database Cluster' {
      projDbNode = node 'PostgreSQL Instance' {
        instanceOf projDjangoFramework.projDb
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its interactions with users and external systems.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal architecture of the Django framework, including the request handler, ORM, and data stores.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within Django, showing middleware, URL routing, and views.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Application'
    description 'Typical deployment topology for a Django application using a WSGI/ASGI server and a managed database.'
    include *
  }
}
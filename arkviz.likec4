model {
  projDeveloper = actor 'Developer' {
    description 'Software developer contributing to or using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'User of an application built with the Django framework'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Entry point for web servers to communicate with the Django application'

      projRequestProcessor = component 'Request Processor' {
        description 'Handles incoming HTTP requests and converts them to WSGI/ASGI objects'
      }
      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a series of hooks (Security, CSRF, Session, etc.)'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps the requested URL to the appropriate view function or class'
      }
      projViewHandler = component 'View Handler' {
        description 'Executes business logic and returns a response object'
      }

      projRequestProcessor -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves path'
      projUrlResolver -> projViewHandler 'dispatches to'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQLParse'
      description 'Maps Python models to database tables and handles query generation'
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using templates'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Contrib Admin, JavaScript'
      description 'Automatic administrative interface for managing site content'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching system for performance optimization'
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Internal task backend for asynchronous processing'
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Django Contrib Auth'
      description 'Handles user authentication, permissions, and groups'
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders views'
    projWsgiHandler -> projCacheSystem 'reads/writes cache'
    projWsgiHandler -> projAuthSystem 'validates users'
    projWsgiHandler -> projTaskSystem 'enqueues background jobs'
    projAdminInterface -> projWsgiHandler 'calls management APIs'
    projOrm -> projCacheSystem 'caches query results'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Persistent storage for application data'
  }

  projEmailServer = external 'Email Service' {
    technology 'SMTP, SendGrid'
    description 'External service for sending notifications and password resets'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'S3, GCS, Local Filesystem'
    description 'Storage for static assets and user-uploaded media'
  }

  projDeveloper -> projDjangoFramework 'develops and configures' {
    technology 'Python'
  }
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projEmailServer 'sends emails' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projStaticStorage 'serves/uploads files' {
    technology 'HTTPS'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural components of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing flow within the Django handler.'
    include *
  }
}
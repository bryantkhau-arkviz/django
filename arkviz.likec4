model {
  projWebUser = actor 'Web User' {
    description 'Developer or end user accessing a Django-powered web application'
  }

  projAppDeveloper = actor 'Application Developer' {
    description 'Builds Django apps, runs management commands, and configures settings'
  }

  projOpsEngineer = actor 'Ops Engineer' {
    description 'Deploys Django via WSGI or ASGI servers and monitors runtime behavior'
  }

  projCiMaintainer = actor 'CI Maintainer' {
    description 'Maintains GitHub Actions workflows for tests, coverage, docs, and quality checks'
  }

  projGitHubActions = external 'GitHub Actions' {
    technology 'GitHub Actions'
    description 'CI/CD automation platform executing repository workflows'
  }

  projPostgreSql = external 'PostgreSQL Server' {
    technology 'PostgreSQL'
    description 'Relational database backend used by Django in test and production scenarios'
  }

  projPostGis = external 'PostGIS Database' {
    technology 'PostgreSQL + PostGIS'
    description 'Geospatial database backend used by GeoDjango tests'
  }

  projSphinx = external 'Sphinx Toolchain' {
    technology 'Sphinx, sphinxcontrib-spelling, sphinx-lint'
    description 'Documentation build and lint ecosystem'
  }

  projNodeTooling = external 'Node.js Test Tooling' {
    technology 'Node.js, Grunt, QUnit, Puppeteer, ESLint'
    description 'JavaScript tooling used for frontend/static asset tests'
  }

  projDjangoOrg = system 'Django Framework' {
    description 'Python web framework providing request handling, ORM, templating, middleware, admin, auth, and management tooling'

    projHttpRuntime = service 'HTTP Runtime Layer' {
      technology 'Python 3.12+, WSGI, ASGI'
      description 'Entry points and handlers for synchronous WSGI and asynchronous ASGI request processing'
    }

    projCoreKernel = service 'Core Framework Kernel' {
      technology 'Python'
      description 'Core services including URL routing, middleware execution, HTTP abstractions, signals, checks, and management command infrastructure'
    }

    projTemplateEngine = service 'Template and View Rendering' {
      technology 'Django Templates, Jinja2 integration'
      description 'Template backends, loaders, context processing, generic views, and response rendering'
    }

    projContribSuite = service 'Contrib Applications Suite' {
      technology 'django.contrib'
      description 'Reusable framework apps such as admin, auth, sessions, messages, sites, staticfiles, sitemaps, contenttypes, and GIS extensions'
    }

    projOrmLayer = service 'ORM and Migrations Engine' {
      technology 'Django ORM, django.db.migrations, sqlparse'
      description 'Model layer, query construction, database backend abstraction, schema migration planning, and execution'
    }

    projCacheIntegration = integration 'Cache Backend Integration' {
      technology 'django.core.cache'
      description 'Unified cache API integrated with middleware and template tags across pluggable backends'
    }

    projTaskApi = integration 'Task Backend Interface' {
      technology 'django.tasks'
      description 'Abstraction layer for task execution backends including immediate and dummy implementations'
    }

    projCliTool = service 'Management CLI' {
      technology 'django-admin, django.core.management'
      description 'Command-line interface for project lifecycle operations and administrative tasks'
    }

    projStaticAssets = frontend 'Admin and Static Asset Frontend' {
      technology 'HTML, CSS, JavaScript, staticfiles'
      description 'Admin UI assets and static file serving pipeline for browser-based interfaces'
    }

    projFrameworkStateDb = database 'Application Data Store' {
      technology 'SQLite or PostgreSQL via Django DB backends'
      description 'Logical persistence target for framework-managed models, sessions, auth data, and application content'
    }

    projHttpRuntime -> projCoreKernel 'forwards HTTP requests for processing' {
      technology 'WSGI/ASGI call interface'
    }
    projCoreKernel -> projTemplateEngine 'renders responses with templates and view logic' {
      technology 'Python API calls'
    }
    projCoreKernel -> projContribSuite 'invokes installed contrib app features' {
      technology 'Python module integration'
    }
    projCoreKernel -> projOrmLayer 'executes model queries and transactions' {
      technology 'ORM APIs'
    }
    projCoreKernel -> projCacheIntegration 'uses cache lookups and invalidation' {
      technology 'Cache API'
    }
    projCoreKernel -> projTaskApi 'dispatches background task calls through backend interface' {
      technology 'Python API calls'
    }
    projContribSuite -> projOrmLayer 'persists auth, session, site, and admin metadata' {
      technology 'ORM queries'
    }
    projTemplateEngine -> projStaticAssets 'serves and references static assets in rendered pages' {
      technology 'HTTP static asset paths'
    }
    projOrmLayer -> projFrameworkStateDb 'reads and writes relational data' {
      technology 'SQL'
    }
    projCliTool -> projCoreKernel 'loads settings and executes framework commands' {
      technology 'Python command execution'
    }
    projCliTool -> projOrmLayer 'creates and applies migrations' {
      technology 'Migration executor'
    }

    projRequestHandler = component 'Request Handler Pipeline' {
      description 'Builds request/response flow, executes middleware chain, and dispatches to views'
    }

    projUrlResolver = component 'URL Resolver' {
      description 'Resolves URL patterns and maps requests to view callables'
    }

    projMiddlewareChain = component 'Middleware Chain Executor' {
      description 'Applies security, CSRF, session, locale, and other middleware around request handling'
    }

    projSignalBus = component 'Signal Dispatcher' {
      description 'Publishes lifecycle events such as request started and model signals'
    }

    projSystemChecks = component 'System Check Framework' {
      description 'Runs configuration and runtime checks for databases, templates, caches, and URLs'
    }

    projRequestHandler -> projUrlResolver 'resolves route target'
    projRequestHandler -> projMiddlewareChain 'applies middleware processing'
    projRequestHandler -> projSignalBus 'emits request lifecycle signals'
    projRequestHandler -> projSystemChecks 'validates configuration when needed'
  }

  projWebUser -> projDjangoOrg.projStaticAssets 'uses browser UI delivered by Django apps' {
    technology 'HTTPS'
  }
  projAppDeveloper -> projDjangoOrg.projCliTool 'runs administrative and project commands' {
    technology 'CLI'
  }
  projOpsEngineer -> projDjangoOrg.projHttpRuntime 'deploys and operates runtime entrypoints' {
    technology 'WSGI/ASGI'
  }
  projCiMaintainer -> projGitHubActions 'configures and triggers workflow pipelines' {
    technology 'GitHub API'
  }

  projGitHubActions -> projDjangoOrg.projCliTool 'executes test, migration, and framework command suites' {
    technology 'Python CLI'
  }
  projGitHubActions -> projPostgreSql 'runs integration tests against relational backend' {
    technology 'SQL over TCP'
  }
  projGitHubActions -> projPostGis 'runs geospatial test matrix for GeoDjango' {
    technology 'SQL/PostGIS'
  }
  projGitHubActions -> projSphinx 'builds and lints documentation artifacts' {
    technology 'Sphinx CLI'
  }
  projGitHubActions -> projNodeTooling 'runs JavaScript lint and test workflows' {
    technology 'npm, Grunt, QUnit'
  }

  projDjangoOrg.projOrmLayer -> projPostgreSql 'connects to configured PostgreSQL backend' {
    technology 'psycopg, SQL'
  }
  projDjangoOrg.projContribSuite -> projPostGis 'uses GIS database capabilities via GeoDjango' {
    technology 'PostGIS SQL'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Actors, Django framework boundary, and external platforms used for runtime and CI'
    include *
  }

  view projectContainers of projDjangoOrg {
    title 'Containers - Django Framework'
    description 'Major framework runtime containers, integrations, data stores, and internal data flow'
    include *
  }

  view projectComponents of projDjangoOrg.projCoreKernel {
    title 'Components - Core Framework Kernel'
    description 'Internal components responsible for request orchestration, routing, middleware, signaling, and checks'
    include *
  }
}
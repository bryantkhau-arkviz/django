specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-powered web application'
  }

  projAdmin = actor 'Django Administrator' {
    description 'Manages application data and users via the built-in admin interface'
  }

  projDjango = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'The entry point for web servers to communicate with the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewProcessor = component 'View Processor' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewProcessor 'calls view'
      projViewProcessor -> projTemplateEngine 'renders'
    }

    projAdminApp = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing models'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, or Oracle'
      description 'Stores application data, sessions, and user information'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCache = cache 'Cache Framework' {
      technology 'Redis, Memcached, or Local Memory'
      description 'Pluggable cache system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Asynchronous task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCache 'caches responses/data'
    projWsgiHandler -> projTaskQueue 'triggers background tasks'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminApp -> projWsgiHandler 'uses'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'S3, Cloud Storage'
    description 'Hosts static assets and user-uploaded files'
  }

  projUser -> projDjango.projWsgiHandler 'interacts with' {
    technology 'HTTPS'
  }
  projAdmin -> projDjango.projAdminApp 'manages site' {
    technology 'HTTPS'
  }
  projDjango.projWsgiHandler -> projEmailService 'sends emails' {
    technology 'SMTP/HTTPS'
  }
  projDjango.projWsgiHandler -> projStaticStorage 'serves/uploads files'
}

deployment {
  projProdEnv = environment 'Production' {
    projWebZone = zone 'Application Tier' {
      projAppServer = node 'Gunicorn/Uvicorn' {
        instanceOf projDjango.projWsgiHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database' {
        instanceOf projDjango.projDatabase
      }
      projCacheNode = node 'Managed Redis' {
        instanceOf projDjango.projCache
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of Django and its interactions with users and external systems.'
    include *
  }

  view projectContainers of projDjango {
    title 'Containers - Django Web Framework'
    description 'Internal architecture of the Django framework including ORM, Cache, and Handlers.'
    include *
  }

  view projectComponents of projDjango.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline including Middleware, Routing, and Views.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard deployment pattern for a Django application using WSGI/ASGI servers and managed data services.'
    include *
  }
}
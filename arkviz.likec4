specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with the web application'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and configuration through the admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWebHandler = service 'Web Server Handler' {
      technology 'WSGI/ASGI, Python'
      description 'Handles incoming HTTP requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projAdminApp = service 'Admin Interface' {
      technology 'Python, Django Contrib'
      description 'Built-in administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projOrm = service 'ORM / Database Layer' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database abstraction'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, LocMem'
      description 'Pluggable caching framework for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projTaskSystem = service 'Task Queue' {
      technology 'Python'
      description 'Asynchronous task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data and Django metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projWebHandler -> projOrm 'queries data'
    projWebHandler -> projCacheSystem 'caches responses'
    projWebHandler -> projTaskSystem 'triggers background jobs'
    projAdminApp -> projOrm 'manages models'
    projOrm -> projDatabase 'executes SQL'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery'
  }

  projUser -> projDjangoFramework.projWebHandler 'accesses application' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminApp 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWebHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProd = environment 'Production' {
    projAppServer = node 'Application Server' {
      instanceOf projDjangoFramework.projWebHandler
      instanceOf projDjangoFramework.projAdminApp
    }
    projDbServer = node 'Database Server' {
      instanceOf projDjangoFramework.projDatabase
    }
    projCacheServer = node 'Cache Server' {
      instanceOf projDjangoFramework.projCacheSystem
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal architecture of the Django framework showing core services and data stores.'
    include *
  }

  view projectComponents of projDjangoFramework.projWebHandler {
    title 'Components - Web Server Handler'
    description 'Internal components of the request handling pipeline in Django.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Setup'
    description 'Standard deployment architecture for a Django application.'
    include *
  }
}
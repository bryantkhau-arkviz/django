specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the Web Server Gateway Interface'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/wsgi.py'
      }

      projRequestFactory = component 'WSGI Request Factory' {
        description 'Constructs WSGIRequest objects from the environment'
        metadata {
          sourceFiles 'django/core/handlers/wsgi.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a configurable stack of middleware'
        metadata {
          sourceFiles 'django/core/handlers/base.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py'
        }
      }

      projViewProcessor = component 'View Processor' {
        description 'Executes the logic for a specific request and returns a response'
        metadata {
          sourceFiles 'django/core/handlers/base.py'
        }
      }

      projRequestFactory -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves URL'
      projUrlResolver -> projViewProcessor 'invokes view'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests via the Asynchronous Server Gateway Interface'
      metadata {
        sourceFiles 'django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps Python classes to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Python, Django Templates, Jinja2'
      description 'Renders dynamic HTML content using templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Python, Redis, Memcached'
      description 'Pluggable caching system for improving performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Handles background tasks and asynchronous processing'
      metadata {
        sourceFiles 'django/tasks/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projAsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders templates'
    projAsgiHandler -> projTemplateEngine 'renders templates'
    projWsgiHandler -> projCacheSystem 'reads/writes cache'
    projAdminInterface -> projWsgiHandler 'uses'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, SQLite, MySQL, Oracle'
    description 'Stores application data'
  }

  projExternalAuth = external 'Auth Provider' {
    description 'External authentication services (OAuth, OpenID)'
  }

  projEmailService = external 'Email Service' {
    description 'SMTP or API-based email delivery'
  }

  projDeveloper -> projDjangoFramework 'develops apps with'
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses app' {
    technology 'HTTP/HTTPS'
  }
  projEndUser -> projDjangoFramework.projAsgiHandler 'accesses app' {
    technology 'WebSocket/HTTP'
  }
  projDjangoFramework.projOrm -> projDatabase 'executes SQL' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projExternalAuth 'authenticates via'
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail'
}

deployment {
  projProdEnv = environment 'Production' {
    projWebZone = zone 'Web Tier' {
      projAppServer = node 'Application Server (Gunicorn/Uvicorn)' {
        instanceOf projDjangoFramework.projWsgiHandler
        instanceOf projDjangoFramework.projAsgiHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database (RDS/Cloud SQL)' {
        instanceOf projDatabase
      }
      projCacheNode = node 'Managed Cache (ElastiCache/Redis)' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural building blocks of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing pipeline within the WSGI Handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard deployment architecture for a Django-based application.'
    include *
  }
}
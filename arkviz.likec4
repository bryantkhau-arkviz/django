specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Software developer building web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'User of a web application built with Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system'

      projMiddlewareStack = component 'Middleware Stack' {
        description 'Processes requests and responses globally (Security, CSRF, Sessions, Auth)'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions or classes'
      }
      projViewSystem = component 'View System' {
        description 'Executes business logic and returns HTTP responses'
      }
      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2'
      }

      projMiddlewareStack -> projUrlResolver 'passes processed request'
      projUrlResolver -> projViewSystem 'dispatches to'
      projViewSystem -> projTemplateEngine 'uses for rendering'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps Python models to database tables and handles migrations'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, JavaScript, CSS'
      description 'Automatic administrative interface for managing application data'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, LocMem'
      description 'Pluggable caching system for performance optimization'
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Python'
      description 'Background task execution and asynchronous processing'
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCacheSystem 'reads/writes cached data'
    projWsgiHandler -> projTaskSystem 'enqueues background jobs'
    projAdminInterface -> projWsgiHandler 'uses for data management'
    projOrm -> projWsgiHandler 'provides data models'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database for data storage'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid'
    description 'External service for sending transactional emails'
  }

  projGithubActions = external 'GitHub Actions' {
    technology 'YAML'
    description 'CI/CD platform for running tests, benchmarks, and linters'
  }

  projDeveloper -> projDjangoFramework 'develops applications with'
  projDeveloper -> projGithubActions 'triggers workflows'
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses web application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends emails' {
    technology 'SMTP'
  }
  projGithubActions -> projDjangoFramework 'runs tests and linters on'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'The Django framework, its users, and external dependencies'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'Core internal services and components of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django Handler'
    include *
  }
}
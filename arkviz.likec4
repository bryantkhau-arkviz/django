specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built with Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/__init__.py, django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCoreHandler = service 'Core Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Main request/response processing engine supporting both synchronous and asynchronous modes'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/core/handlers/wsgi.py, django/core/handlers/asgi.py'
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Processes logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddlewareChain -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database'
      description 'Unified interface for multiple cache backends'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projTaskSystem = queue 'Task System' {
      technology 'Python'
      description 'Background task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projAuthSystem = service 'Auth System' {
      technology 'Python'
      description 'Authentication and authorization framework'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projAdminInterface -> projCoreHandler 'submits requests' {
      technology 'HTTP'
    }
    projCoreHandler -> projOrm 'queries data'
    projCoreHandler -> projCacheSystem 'accesses cache'
    projCoreHandler -> projAuthSystem 'validates users'
    projCoreHandler -> projTaskSystem 'enqueues tasks'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database for persistent storage'
  }

  projEmailProvider = external 'Email Service' {
    technology 'SMTP'
    description 'External service for sending emails'
  }

  projDeveloper -> projDjangoFramework 'configures and extends'
  projEndUser -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projCoreHandler -> projEmailProvider 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Tier' {
      projWebServer = node 'WSGI/ASGI Server' {
        instanceOf projDjangoFramework.projCoreHandler
      }
      projAdminNode = node 'Admin App' {
        instanceOf projDjangoFramework.projAdminInterface
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed Database' {
        instanceOf projPostgres
      }
      projCacheNode = node 'ElastiCache/Redis' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal architecture of the Django framework including Core Handlers, ORM, and Contrib apps.'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Core Handler'
    description 'Internal components of the Django request/response processing pipeline.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Application'
    description 'Typical production deployment for a Django-based application.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'Accesses web applications built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'Builds and manages applications using the Django framework'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them to the appropriate view'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/base.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the corresponding view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a series of hooks (security, sessions, etc.)'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewProcessor = component 'View Processor' {
        description 'Executes business logic and returns an HTTP response'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewProcessor 'executes'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Provides an abstraction layer for database operations using Python objects'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/loader.py, django/template/backends/django.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Contrib Admin, JavaScript, CSS'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projManagementCli = service 'Management CLI' {
      technology 'Python, django-admin'
      description 'Command-line utility for administrative tasks like migrations and server management'
      metadata {
        sourceFiles 'django/core/management/__init__.py, django/core/management/base.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, LocMem'
      description 'Pluggable caching system to improve performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Background task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data' {
      technology 'Python API'
    }
    projWsgiHandler -> projTemplateEngine 'renders views' {
      technology 'Python API'
    }
    projWsgiHandler -> projCacheSystem 'accesses cache' {
      technology 'Python API'
    }
    projAdminInterface -> projWsgiHandler 'uses' {
      technology 'HTTP'
    }
    projManagementCli -> projOrm 'manages schema/data' {
      technology 'Python API'
    }
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projExternalAuth = external 'Auth Provider' {
    description 'External authentication services (OAuth, OpenID)'
  }

  projEmailService = external 'Email Service' {
    description 'SMTP or API-based email delivery'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'interacts with app' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projManagementCli 'runs commands' {
    technology 'Shell'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projExternalAuth 'authenticates via' {
    technology 'HTTPS/OIDC'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends mail' {
    technology 'SMTP/HTTPS'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and systems that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal components of the request handling pipeline in Django.'
    include *
  }
}
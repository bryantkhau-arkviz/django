specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a Django-powered web application'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and users via the Django Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, or Daphne'
      description 'The interface between the web server and the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py'
      }
    }

    projDjangoApp = service 'Django Application' {
      technology 'Python, Django'
      description 'The core application logic, handling requests, templates, and business rules'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/conf/global_settings.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewHandler = component 'View Handler' {
        description 'Processes requests and returns responses using generic or custom views'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projOrm = component 'ORM (Object-Relational Mapper)' {
        description 'Translates Python model definitions into database queries'
        metadata {
          sourceFiles 'django/db/models/base.py, django/db/models/query.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Django request/response processing for security, sessions, etc.'
        metadata {
          sourceFiles 'django/middleware/common.py, django/contrib/sessions/middleware.py, django/middleware/csrf.py'
        }
      }

      projUrlResolver -> projViewHandler 'dispatches to'
      projViewHandler -> projOrm 'queries data'
      projViewHandler -> projTemplateEngine 'renders'
      projMiddleware -> projUrlResolver 'intercepts'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'Built-in administrative interface for managing models'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, or Oracle'
      description 'Stores application data and Django metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheStore = cache 'Cache Backend' {
      technology 'Redis or Memcached'
      description 'Stores temporary data for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Celery or Django Tasks'
      description 'Handles asynchronous background processing'
      metadata {
        sourceFiles 'django/tasks/base.py'
      }
    }

    projWsgiServer -> projDjangoApp 'forwards requests'
    projDjangoApp -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projDjangoApp -> projCacheStore 'caches data'
    projDjangoApp -> projTaskQueue 'enqueues jobs'
    projAdminInterface -> projDjangoApp 'uses'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP / SendGrid / Amazon SES'
    description 'Sends system notifications and user emails'
  }

  projUser -> projDjangoFramework.projWsgiServer 'accesses application' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projDjangoApp -> projEmailService 'sends emails' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestNode = node 'Ubuntu Runner' {
      projPostgresNode = node 'PostgreSQL Service' {
        instanceOf projDjangoFramework.projDatabase
      }
      projPythonNode = node 'Python Runtime' {
        instanceOf projDjangoFramework.projDjangoApp
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and data stores of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projDjangoApp {
    title 'Components - Django Application'
    description 'Internal modules within the core Django application logic'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is deployed for testing in GitHub Actions'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpServer = service 'HTTP Server' {
      technology 'WSGI/ASGI, Python'
      description 'Handles incoming HTTP requests and routes them to the appropriate handler.'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/servers/basehttp.py'
      }

      projMiddleware = component 'Middleware Manager' {
        description 'Processes requests and responses globally through a chain of components.'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions or classes.'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewHandler = component 'View Handler' {
        description 'Executes business logic and returns HTTP responses.'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML content using Django or Jinja2 templates.'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewHandler 'dispatches to'
      projViewHandler -> projTemplateEngine 'renders via'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Maps Python objects to database tables and manages migrations.'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/migrations/executor.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing application data.'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and session management.'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system to improve performance.'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Python'
      description 'Background task execution and scheduling framework.'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/immediate.py'
      }
    }

    projHttpServer -> projOrm 'queries data' {
      technology 'Python API'
    }
    projHttpServer -> projAuthSystem 'authenticates users'
    projHttpServer -> projCacheSystem 'caches responses'
    projAdminInterface -> projOrm 'manages models'
    projAdminInterface -> projAuthSystem 'verifies staff access'
    projHttpServer -> projTaskSystem 'triggers background jobs'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database for data persistence.'
  }

  projExternalMail = external 'Email Service' {
    technology 'SMTP/HTTPS'
    description 'External service for sending notifications (e.g., SendGrid, Amazon SES).'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'configures and manages data' {
    technology 'HTTPS'
  }
  projEndUser -> projDjangoFramework.projHttpServer 'accesses web application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projHttpServer -> projExternalMail 'sends emails'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projAppNode = node 'Gunicorn/Uvicorn Worker' {
        instanceOf projDjangoFramework.projHttpServer
      }
      projAdminNode = node 'Admin Instance' {
        instanceOf projDjangoFramework.projAdminInterface
      }
    }
    projDbZone = zone 'Database Cluster' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projPostgres
      }
    }
    projCacheNode = node 'Redis Instance' {
      instanceOf projDjangoFramework.projCacheSystem
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core internal services of the Django framework including HTTP handling, ORM, and Admin.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpServer {
    title 'Components - HTTP Server'
    description 'Internal request processing pipeline including Middleware, URL Routing, and Views.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard deployment architecture for a Django-based application.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI/ASGI'
      description 'Handles incoming web requests via WSGI or ASGI interfaces'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses globally'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projMiddlewareChain -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'dispatches to'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps Python objects to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/views.py, django/contrib/sessions/middleware.py'
      }
    }

    projCacheFramework = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Python'
      description 'Background task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projTemplateEngine 'renders views'
    projHttpHandler -> projAuthSystem 'authenticates users'
    projHttpHandler -> projCacheFramework 'caches responses'
    projAdminInterface -> projHttpHandler 'uses'
    projAuthSystem -> projOrm 'persists users/sessions'
    projViewEngine -> projTaskQueue 'triggers background jobs'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projExternalAuth = external 'External Auth Provider' {
    description 'OAuth/OpenID Connect providers (e.g., Google, GitHub)'
  }

  projEndUser -> projDjangoFramework.projHttpHandler 'accesses application' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projAuthSystem -> projExternalAuth 'delegates auth' {
    technology 'OAuth 2.0'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppServer = node 'Web Server' {
      instanceOf projDjangoFramework.projHttpHandler
    }
    projDbServer = node 'Database Server' {
      instanceOf projDatabase
    }
    projCacheServer = node 'Cache Server' {
      instanceOf projDjangoFramework.projCacheFramework
    }
    projAppServer -> projDbServer 'connects'
    projAppServer -> projCacheServer 'connects'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework and its interactions with developers, users, and external systems.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and systems that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal modules within the HTTP Handler service that process web requests.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Framework'
    description 'Typical production deployment of a Django-based application.'
    include *
  }
}
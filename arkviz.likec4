specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiAsgiHandler = service 'Request Handler (WSGI/ASGI)' {
      technology 'Python, WSGI, ASGI'
      description 'Entry point for web servers to communicate with Django applications'

      projMiddleware = component 'Middleware Layer' {
        description 'Hooks into request/response processing (Auth, CSRF, Security, Sessions)'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
      }
      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
      }
      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2'
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders UI'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps Python classes to database tables and handles migrations'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin, JavaScript'
      description 'Automatic administrative interface for managing site content'
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Handles asynchronous background processing'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached'
      description 'Pluggable caching system for performance optimization'
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data and metadata'
    }

    projWsgiAsgiHandler -> projOrm 'queries data'
    projWsgiAsgiHandler -> projCacheSystem 'caches responses'
    projWsgiAsgiHandler -> projTaskQueue 'enqueues jobs'
    projAdminInterface -> projWsgiAsgiHandler 'uses'
    projOrm -> projDatabase 'executes SQL'
  }

  projWebServer = external 'Web Server' {
    technology 'Nginx, Apache, Gunicorn, Daphne'
    description 'Proxies requests from the internet to the Django application'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid'
    description 'Sends system notifications and user emails'
  }

  projGeospatialService = external 'PostGIS / GDAL' {
    technology 'GeoDjango'
    description 'Provides geospatial capabilities and spatial queries'
  }

  projDeveloper -> projDjangoFramework 'develops apps'
  projEndUser -> projWebServer 'accesses application' {
    technology 'HTTPS'
  }
  projWebServer -> projDjangoFramework.projWsgiAsgiHandler 'forwards requests' {
    technology 'WSGI/ASGI'
  }
  projDjangoFramework.projWsgiAsgiHandler -> projEmailService 'sends mail'
  projDjangoFramework.projOrm -> projGeospatialService 'spatial queries'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'The primary technical building blocks of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiAsgiHandler {
    title 'Components - Request Handler'
    description 'Internal request processing pipeline within the Django Handler'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built with Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpHandler = service 'HTTP Handler' {
      technology 'Python, WSGI/ASGI'
      description 'Handles incoming web requests via WSGI or ASGI interfaces'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Manager' {
        description 'Processes requests and responses through a chain of middleware'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes application logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminApp = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Python'
      description 'Asynchronous task execution framework'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projHttpHandler -> projOrm 'queries data'
    projHttpHandler -> projAuthSystem 'authenticates users'
    projHttpHandler -> projCacheSystem 'caches responses'
    projAdminApp -> projHttpHandler 'uses'
    projHttpHandler -> projTaskSystem 'triggers background jobs'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP'
    description 'Sends system emails and notifications'
  }

  projDeveloper -> projDjangoFramework 'develops apps with'
  projEndUser -> projDjangoFramework.projHttpHandler 'accesses web apps' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projHttpHandler -> projEmailService 'sends mail' {
    technology 'SMTP'
  }
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestNode = node 'Ubuntu Runner' {
      projPostgresNode = node 'PostgreSQL Service' {
        instanceOf projDatabase
      }
      projDjangoNode = node 'Django Test Environment' {
        instanceOf projDjangoFramework.projHttpHandler
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework and its environment'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core internal services and systems of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpHandler {
    title 'Components - HTTP Handler'
    description 'Internal request processing components within the HTTP Handler'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested within GitHub Actions infrastructure'
    include *
  }
}
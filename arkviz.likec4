specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Uses Django to build web applications'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built using Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projHttpServer = service 'HTTP Server' {
      technology 'WSGI, ASGI'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/servers/basehttp.py'
      }

      projRequestMiddleware = component 'Middleware Handler' {
        description 'Processes requests and responses through a chain of middleware'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/middleware/common.py, django/middleware/csrf.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML templates using Django or Jinja2 backends'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projRequestMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'dispatches to'
      projViewEngine -> projTemplateEngine 'renders using'
    }

    projOrm = service 'ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/options.py, django/contrib/admin/sites.py'
      }
    }

    projAuthSystem = service 'Auth System' {
      technology 'Python'
      description 'Handles authentication, permissions, and user sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database'
      description 'Pluggable caching framework for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py, django/db/backends/sqlite3/base.py'
      }
    }

    projHttpServer.projViewEngine -> projOrm 'queries data'
    projHttpServer.projViewEngine -> projAuthSystem 'authenticates users'
    projHttpServer.projViewEngine -> projCacheSystem 'caches results'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projHttpServer 'uses'
  }

  projExternalEmail = external 'Email Service' {
    description 'SMTP or third-party email providers'
  }

  projExternalGis = external 'GIS Services' {
    description 'Geographic Information System services (PostGIS, GDAL)'
  }

  projEndUser -> projDjangoFramework.projHttpServer 'accesses web apps' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDjangoFramework.projHttpServer -> projExternalEmail 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projOrm -> projExternalGis 'uses spatial data'
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Cluster' {
      projWebNode = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projHttpServer
      }
    }
    projDbZone = zone 'Database Cluster' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projDjangoFramework.projDatabase
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework and its interactions with developers, users, and external systems.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'High-level internal architecture of the Django framework including core services and data stores.'
    include *
  }

  view projectComponents of projDjangoFramework.projHttpServer {
    title 'Components - HTTP Server'
    description 'Internal request processing components within the Django HTTP handling layer.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'Standard deployment architecture for a Django application.'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Uses the Django framework to build web applications'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with applications built using Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests using the WSGI standard'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/wsgi.py'
      }

      projRequestFactory = component 'Request Factory' {
        description 'Creates WSGIRequest objects from environment dictionaries'
        metadata {
          sourceFiles 'django/core/handlers/wsgi.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses through a configurable stack of middleware'
        metadata {
          sourceFiles 'django/core/handlers/base.py, django/middleware/common.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewProcessor = component 'View Processor' {
        description 'Executes the application logic associated with a URL'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
        }
      }

      projRequestFactory -> projMiddlewareChain 'passes request'
      projMiddlewareChain -> projUrlResolver 'resolves URL'
      projUrlResolver -> projViewProcessor 'calls view'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGI, asgiref'
      description 'Handles asynchronous web requests and protocols like WebSockets'
      metadata {
        sourceFiles 'django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Provides an abstraction layer for database interactions'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Python, Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, CSS, JavaScript'
      description 'Automatic administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Python, Redis, Memcached, Local Memory'
      description 'Pluggable caching system for improving performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/backends/base.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Handles background tasks and asynchronous processing'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projAsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders templates'
    projAsgiHandler -> projTemplateEngine 'renders templates'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projWsgiHandler 'uses'
    projWsgiHandler -> projTaskSystem 'triggers tasks'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, MySQL, SQLite, Oracle'
    description 'Stores application data'
  }

  projEmailServer = external 'Email Server' {
    technology 'SMTP'
    description 'Sends system notifications and user emails'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'S3, Cloud Storage'
    description 'Hosts static files and user-uploaded media'
  }

  projDeveloper -> projDjangoFramework 'builds apps with'
  projEndUser -> projDjangoFramework 'interacts with' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projEmailServer 'sends mail' {
    technology 'SMTP'
  }
  projDjangoFramework.projWsgiHandler -> projStaticStorage 'serves/uploads files' {
    technology 'HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projAppZone = zone 'Application Tier' {
      projWebServer = node 'Gunicorn / Uvicorn' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
      projAsgiServer = node 'Daphne / Hypercorn' {
        instanceOf projDjangoFramework.projAsgiHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbNode = node 'Managed PostgreSQL' {
        instanceOf projDatabase
      }
      projCacheNode = node 'Managed Redis' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The primary architectural components of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing pipeline within the WSGI handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Typical Django Production'
    description 'How Django components are typically deployed in a production environment.'
    include *
  }
}
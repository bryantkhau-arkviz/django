specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A person visiting a website powered by Django'
  }

  projAdmin = actor 'Site Administrator' {
    description 'Manages site content and users via the Django Admin interface'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Web server interface for running Django applications'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py'
      }
    }

    projDjangoApp = service 'Django Application' {
      technology 'Python, Django'
      description 'The core application logic including models, views, and templates'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/conf/global_settings.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming URL requests to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processors for requests and responses (Security, CSRF, Session, etc.)'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Handles business logic and interacts with models/templates'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django Templates or Jinja2'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projOrm = component 'ORM (Object-Relational Mapper)' {
        description 'Translates Python model definitions into database queries'
        metadata {
          sourceFiles 'django/db/models/base.py, django/db/models/query.py'
        }
      }

      projAuthSystem = component 'Auth System' {
        description 'Handles user authentication, permissions, and sessions'
        metadata {
          sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/views.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'passes request'
      projViewEngine -> projOrm 'queries data'
      projViewEngine -> projTemplateEngine 'renders'
      projViewEngine -> projAuthSystem 'authenticates'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data and Django metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheStore = cache 'Cache Backend' {
      technology 'Redis, Memcached'
      description 'Stores temporary data to improve performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks, Celery'
      description 'Handles asynchronous background processing'
      metadata {
        sourceFiles 'django/tasks/base.py'
      }
    }

    projWsgiServer -> projDjangoApp 'forwards requests' {
      technology 'WSGI/ASGI'
    }
    projDjangoApp -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projDjangoApp -> projCacheStore 'caches data'
    projDjangoApp -> projTaskQueue 'enqueues tasks'
    projAdminInterface -> projDjangoApp 'uses'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'Sends system notifications and password resets'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projUser -> projWsgiServer 'visits website' {
    technology 'HTTPS'
  }
  projAdmin -> projAdminInterface 'manages site' {
    technology 'HTTPS'
  }
  projDjangoFramework.projDjangoApp -> projEmailService 'sends emails' {
    technology 'SMTP/HTTPS'
  }
}

deployment {
  projProdEnv = environment 'Production' {
    projCloudZone = zone 'Cloud Provider' {
      projAppNode = node 'Application Server' {
        instanceOf projDjangoFramework.projWsgiServer
        instanceOf projDjangoFramework.projDjangoApp
      }
      projDbNode = node 'Managed Database' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Managed Cache' {
        instanceOf projDjangoFramework.projCacheStore
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal architecture of a Django-based system.'
    include *
  }

  view projectComponents of projDjangoFramework.projDjangoApp {
    title 'Components - Django Application'
    description 'Internal modules within the core Django application container.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Standard Django Stack'
    description 'Typical production deployment for a Django application.'
    include *
  }
}
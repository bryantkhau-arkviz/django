specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-powered web application'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and manages the Django application and its configurations'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML content using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for database interactions'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Templates, JavaScript'
      description 'Built-in administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Infrastructure for background tasks and asynchronous processing'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projCacheLayer = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching framework for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projPrimaryDb = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data and framework metadata'
      metadata {
        sourceFiles 'django/db/backends/postgresql/base.py'
      }
    }

    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCacheLayer 'caches responses'
    projAdminInterface -> projWsgiHandler 'uses'
    projOrm -> projPrimaryDb 'executes SQL' {
      technology 'SQL'
    }
    projTaskSystem -> projOrm 'persists task state'
  }

  projExternalMail = external 'Email Service' {
    description 'External SMTP or API-based email delivery service'
  }

  projGisService = external 'GIS Data Provider' {
    description 'External geospatial data and mapping services'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }
  projUser -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework 'configures and deploys'
  projDjangoFramework.projWsgiHandler -> projExternalMail 'sends emails' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projGisService 'fetches spatial data'
}

deployment {
  projProdEnv = environment 'Production' {
    projWebZone = zone 'Web Tier' {
      projAppServer = node 'Gunicorn/Uvicorn' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
    }
    projDataZone = zone 'Data Tier' {
      projDbServer = node 'Managed PostgreSQL' {
        instanceOf projDjangoFramework.projPrimaryDb
      }
      projCacheServer = node 'Managed Redis' {
        instanceOf projDjangoFramework.projCacheLayer
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core internal services and data stores of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Django Production'
    description 'Typical production deployment architecture for a Django application.'
    include *
  }
}
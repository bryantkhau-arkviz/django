specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with the Django-powered web application'
  }

  projDeveloper = actor 'Django Developer' {
    description 'Developer who builds and maintains applications using the Django framework'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the Web Server Gateway Interface'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/base.py'
      }
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests via the Asynchronous Server Gateway Interface'
      metadata {
        sourceFiles 'django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projOrm = service 'ORM & Database Layer' {
      technology 'Python, SQL'
      description 'Object-Relational Mapper for interacting with various database backends'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/backends/utils.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Python, Django Templates, Jinja2'
      description 'Renders dynamic HTML content using templates'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Python, Redis, Memcached'
      description 'Pluggable caching system for improving performance'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/middleware/cache.py'
      }
    }

    projTaskSystem = queue 'Task Queue' {
      technology 'Python'
      description 'Framework for handling asynchronous tasks and background jobs'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projTemplateEngine 'renders views'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projAsgiHandler -> projOrm 'queries data (async)'
    projAdminInterface -> projOrm 'manages models'
    projWsgiHandler -> projTaskSystem 'triggers background tasks'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database used in testing and production environments'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery service'
  }

  projGitHubActions = external 'GitHub Actions' {
    description 'CI/CD environment for running tests, benchmarks, and linters'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'sends HTTP requests' {
    technology 'HTTPS'
  }
  projUser -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projOrm -> projPostgres 'reads/writes data' {
    technology 'SQL'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/HTTPS'
  }
  projDeveloper -> projGitHubActions 'pushes code'
  projGitHubActions -> projDjangoFramework 'runs tests and benchmarks'

  projWsgiHandler = service 'WSGI Handler' {
    projMiddleware = component 'Middleware Chain' {
      description 'Processes requests and responses through a series of hooks'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/middleware/common.py'
      }
    }
    projUrlResolver = component 'URL Resolver' {
      description 'Maps requested URLs to the appropriate view functions'
      metadata {
        sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
      }
    }
    projViewProcessor = component 'View Processor' {
      description 'Executes business logic and returns HTTP responses'
      metadata {
        sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
      }
    }
    projRequestFactory = component 'Request Factory' {
      description 'Constructs WSGIRequest objects from environment data'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py'
      }
    }

    projRequestFactory -> projMiddleware 'passes request'
    projMiddleware -> projUrlResolver 'resolves path'
    projUrlResolver -> projViewProcessor 'calls view'
    projViewProcessor -> projMiddleware 'returns response'
  }
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'Internal services and subsystems that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI Handler'
    description 'Internal request processing pipeline within the WSGI Handler.'
    include *
  }
}
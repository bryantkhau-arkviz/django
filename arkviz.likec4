specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing a website built with the Django framework'
  }

  projDeveloper = actor 'Developer' {
    description 'A developer using Django to build and deploy web applications'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system'

      projMiddleware = component 'Middleware Stack' {
        description 'Processes requests and responses globally (CSRF, Sessions, Auth, Security)'
      }
      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
      }
      projViewSystem = component 'View System' {
        description 'Executes business logic and returns HTTP responses'
      }
      projTemplateEngine = component 'Template Engine' {
        description 'Renders HTML using Django or Jinja2 templates'
      }

      projMiddleware -> projUrlResolver 'passes processed request'
      projUrlResolver -> projViewSystem 'dispatches to view'
      projViewSystem -> projTemplateEngine 'uses for rendering'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Provides an abstraction layer for database operations using Python models'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin, JavaScript'
      description 'Automatic administrative interface for managing site content'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching backend for performance optimization'
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Asynchronous task execution and background processing'
    }

    projDatabase = database 'Primary Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Relational database storing application data'
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projCacheSystem 'reads/writes cache'
    projWsgiHandler -> projTaskQueue 'enqueues background jobs'
    projOrm -> projDatabase 'executes SQL'
    projAdminInterface -> projWsgiHandler 'uses for data management'
  }

  projExternalEmail = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'External service for sending system notifications and user emails'
  }

  projExternalGis = external 'GIS Services' {
    technology 'PostGIS, GDAL'
    description 'Geospatial data processing and storage'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses web application' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projExternalEmail 'sends emails' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projOrm -> projExternalGis 'processes spatial data'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'High-level overview of the Django framework, its users, and external integrations'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'The core architectural building blocks of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - Request Handler'
    description 'Internal modules responsible for processing HTTP requests within Django'
    include *
  }
}
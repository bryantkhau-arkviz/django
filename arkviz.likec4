specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user interacting with a Django-powered application'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains the Django application'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiServer = service 'WSGI/ASGI Server' {
      technology 'Gunicorn, Uvicorn, Daphne'
      description 'Handles incoming HTTP requests and interfaces with Django via WSGI or ASGI protocols'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }
    }

    projCoreHandler = service 'Django Core Handler' {
      technology 'Python'
      description 'The main request/response processing engine of Django'
      metadata {
        sourceFiles 'django/core/handlers/base.py, django/core/handlers/exception.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'A framework of hooks into Djangos request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewSystem = component 'View System' {
        description 'Processes requests and returns responses using generic or functional views'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django Template Language or Jinja2'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projOrm = component 'ORM (Object-Relational Mapper)' {
        description 'Maps Python classes to database tables and handles queries'
        metadata {
          sourceFiles 'django/db/models/base.py, django/db/models/query.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewSystem 'executes'
      projViewSystem -> projTemplateEngine 'renders'
      projViewSystem -> projOrm 'queries data'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Stores application data and Django metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projCacheSystem = cache 'Cache Backend' {
      technology 'Redis, Memcached'
      description 'Provides a unified interface for caching data'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Celery, Django Tasks'
      description 'Handles asynchronous background tasks'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiServer -> projCoreHandler 'forwards requests' {
      technology 'WSGI/ASGI'
    }
    projCoreHandler -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projCoreHandler -> projCacheSystem 'gets/sets'
    projCoreHandler -> projTaskQueue 'enqueues'
    projAdminInterface -> projCoreHandler 'uses'
  }

  projEmailService = external 'Email Service' {
    technology 'SMTP, SendGrid, Amazon SES'
    description 'Sends transactional emails'
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'Amazon S3, WhiteNoise'
    description 'Hosts static files and user-uploaded media'
  }

  projUser -> projDjangoFramework.projWsgiServer 'accesses application' {
    technology 'HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }
  projDjangoFramework.projCoreHandler -> projEmailService 'sends mail' {
    technology 'SMTP/HTTPS'
  }
  projDjangoFramework.projCoreHandler -> projStaticStorage 'serves/stores files'
}

deployment {
  projProdEnv = environment 'Production' {
    projCloudZone = zone 'Cloud Provider' {
      projAppNode = node 'Application Server' {
        instanceOf projDjangoFramework.projWsgiServer
        instanceOf projDjangoFramework.projCoreHandler
      }
      projDbNode = node 'Managed Database' {
        instanceOf projDjangoFramework.projDatabase
      }
      projCacheNode = node 'Managed Cache' {
        instanceOf projDjangoFramework.projCacheSystem
      }
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The internal architecture of Django including the handler, admin, database, and cache systems.'
    include *
  }

  view projectComponents of projDjangoFramework.projCoreHandler {
    title 'Components - Django Core Handler'
    description 'Internal building blocks of the Django request/response lifecycle.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - Production Environment'
    description 'Typical production deployment of a Django application.'
    include *
  }
}
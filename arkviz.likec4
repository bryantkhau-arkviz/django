specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'The entry point for web servers to communicate with the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/handlers/asgi.py, django/core/asgi.py'
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Processes requests and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/core/handlers/base.py'
        }
      }

      projMiddlewareChain -> projUrlResolver 'passes request'
      projUrlResolver -> projViewEngine 'routes to'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Generates dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, CSS, JavaScript'
      description 'Automatic administrative interface for managing site content'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions, and sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Handles background tasks and asynchronous execution'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data via'
    projWsgiHandler -> projTemplateEngine 'renders UI via'
    projWsgiHandler -> projAuthSystem 'authenticates via'
    projAdminInterface -> projWsgiHandler 'uses'
    projWsgiHandler -> projTaskSystem 'triggers background jobs'
  }

  projDatabase = database 'Relational Database' {
    technology 'PostgreSQL, SQLite, MySQL, Oracle'
    description 'Stores application data'
  }

  projCacheStore = cache 'Cache Store' {
    technology 'Redis, Memcached'
    description 'Caches data for performance'
    metadata {
      sourceFiles 'django/core/cache/__init__.py'
    }
  }

  projExternalMail = external 'Email Service' {
    technology 'SMTP'
    description 'Sends system emails'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'manages content' {
    technology 'HTTPS'
  }

  projDjangoFramework.projOrm -> projDatabase 'reads/writes' {
    technology 'SQL'
  }

  projDjangoFramework.projWsgiHandler -> projCacheStore 'reads/writes' {
    technology 'Cache Protocol'
  }

  projDjangoFramework.projWsgiHandler -> projExternalMail 'sends notifications' {
    technology 'SMTP'
  }
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestNode = node 'Test Runner' {
      description 'Runs Django test suite across Python/DB matrix'
      metadata {
        sourceFiles '.github/workflows/tests.yml, .github/workflows/python_matrix.yml'
      }
    }
    projPostgresNode = node 'PostgreSQL Service' {
      instanceOf projDatabase
    }
    projTestNode -> projPostgresNode 'runs tests against'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and systems that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - Request Handler'
    description 'Internal modules within the WSGI/ASGI request handling pipeline.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI/CD Pipeline'
    description 'How Django is tested and validated in GitHub Actions.'
    include *
  }
}
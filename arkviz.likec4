specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Entry point for web servers to interface with the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses globally (security, sessions, CSRF)'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'invokes'
      projViewEngine -> projTemplateEngine 'renders with'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Translates Python model definitions into database schemas and queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = service 'Admin Interface' {
      technology 'Python, HTML, CSS, JS'
      description 'Automatic administrative interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user accounts, groups, permissions, and cookie-based sessions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/auth/middleware.py'
      }
    }

    projTaskQueue = queue 'Task Queue (Abstract)' {
      technology 'Python'
      description 'Abstract backend for asynchronous task execution'
      metadata {
        sourceFiles 'django/tasks/backends/base.py, django/tasks/base.py'
      }
    }

    projCacheLayer = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data and Django metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py, django/contrib/postgres/apps.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheLayer 'caches responses/fragments'
    projAdminInterface -> projOrm 'manages records'
    projOrm -> projDatabase 'executes SQL'
    projWsgiHandler -> projTaskQueue 'enqueues background jobs'
  }

  projExternalMail = external 'Email Service' {
    technology 'SMTP'
    description 'Sends system notifications and user emails'
    metadata {
      sourceFiles 'django/core/mail/message.py'
    }
  }

  projStaticStorage = external 'Static/Media Storage' {
    technology 'S3, Cloud Storage, Local Filesystem'
    description 'Serves CSS, JS, and user-uploaded files'
    metadata {
      sourceFiles 'django/contrib/staticfiles/storage.py, django/core/files/storage.py'
    }
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'configures and manages data' {
    technology 'HTTPS'
  }
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses web application' {
    technology 'HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projExternalMail 'sends emails' {
    technology 'SMTP'
  }
  projDjangoFramework.projWsgiHandler -> projStaticStorage 'serves assets from' {
    technology 'HTTPS'
  }
}

deployment {
  projCI = environment 'GitHub Actions CI' {
    projTestRunner = node 'Test Runner' {
      instanceOf projDjangoFramework.projWsgiHandler
    }
    projPostgresNode = node 'PostgreSQL Service' {
      instanceOf projDjangoFramework.projDatabase
    }
    projTestRunner -> projPostgresNode 'runs migrations and tests'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'The Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Core subsystems of the Django framework including Request Handling, ORM, and Auth.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - Request Handler'
    description 'Internal request processing pipeline from URL routing to Template rendering.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'Infrastructure used for running Django framework tests in GitHub Actions.'
    include *
  }
}
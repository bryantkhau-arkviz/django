specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing the web application built with Django'
  }

  projAdmin = actor 'Django Admin' {
    description 'Administrator managing the application via the Django Admin interface'
  }

  projDeveloper = actor 'Developer' {
    description 'Software engineer contributing to the Django framework'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them through the middleware and view system.'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Stack' {
        technology 'Python'
        description 'A framework of hooks into Djangos request/response processing.'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        technology 'Python'
        description 'Maps the requested URL to the appropriate view function or class.'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewSystem = component 'View System' {
        technology 'Python'
        description 'Processes requests and returns responses, often using templates and models.'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        technology 'Python, Django Templates, Jinja2'
        description 'Renders dynamic HTML content using templates.'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py'
        }
      }

      projMiddleware -> projUrlResolver 'routes request'
      projUrlResolver -> projViewSystem 'dispatches to'
      projViewSystem -> projTemplateEngine 'renders using'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps Python classes to database tables and provides an API for querying data.'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Built-in administration interface for managing application data.'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and sessions.'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py, django/contrib/sessions/middleware.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Python, Memcached, Redis'
      description 'Provides a unified interface for various caching backends.'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskSystem = service 'Tasks System' {
      technology 'Python'
      description 'Handles asynchronous tasks and background processing.'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data managed by the ORM.'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projWsgiHandler 'uses'
    projOrm -> projDatabase 'reads/writes' {
      technology 'SQL'
    }
    projAuthSystem -> projOrm 'stores user data'
    projTaskSystem -> projOrm 'processes data'
  }

  projExternalDb = external 'PostgreSQL' {
    description 'External PostgreSQL database used for testing and production deployments.'
  }

  projGithubActions = external 'GitHub Actions' {
    description 'CI/CD platform running tests, benchmarks, and linters.'
  }

  projTrac = external 'Trac' {
    description 'Issue tracker for the Django project.'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }
  projAdmin -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }
  projDeveloper -> projGithubActions 'triggers workflows'
  projDeveloper -> projTrac 'manages issues'
  projDjangoFramework.projOrm -> projExternalDb 'connects to' {
    technology 'PostgreSQL Protocol'
  }
  projGithubActions -> projDjangoFramework 'tests and builds'
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external dependencies.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'Internal services and components that make up the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal modules within the request handling pipeline.'
    include *
  }
}
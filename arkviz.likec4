specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

}

model {
  projDeveloper = actor 'Django Developer' {
    description 'Builds and maintains web applications using the Django framework'
  }

  projEndUser = actor 'End User' {
    description 'Interacts with web applications built on Django'
  }

  projDjangoFramework = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI Handler' {
      technology 'Python, WSGI'
      description 'Handles synchronous web requests via the Web Server Gateway Interface'
    }

    projAsgiHandler = service 'ASGI Handler' {
      technology 'Python, ASGIRef'
      description 'Handles asynchronous web requests via the Asynchronous Server Gateway Interface'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python'
      description 'Maps database tables to Python classes and handles query generation'
      
      projQueryEngine = component 'Query Engine' {
        description 'Translates Python QuerySets into SQL statements'
      }
      projModelRegistry = component 'Model Registry' {
        description 'Maintains the mapping of all installed models and their relationships'
      }
      projMigrationEngine = component 'Migration Engine' {
        description 'Manages database schema changes over time'
      }

      projQueryEngine -> projModelRegistry 'looks up model metadata'
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content using various template backends'
    }

    projMiddleware = service 'Middleware Layer' {
      technology 'Python'
      description 'Hooks into request/response processing for security, sessions, and common tasks'
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Django Admin, HTML/CSS/JS'
      description 'Automatic administrative interface for managing application data'
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Local Memory'
      description 'Pluggable caching system for performance optimization'
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Framework for background task execution and scheduling'
    }

    projWsgiHandler -> projMiddleware 'passes request through'
    projAsgiHandler -> projMiddleware 'passes request through'
    projMiddleware -> projTemplateEngine 'triggers rendering'
    projMiddleware -> projOrm 'queries data'
    projAdminInterface -> projOrm 'manages data'
    projOrm -> projCacheSystem 'caches query results'
  }

  projPostgres = database 'PostgreSQL' {
    technology 'PostgreSQL'
    description 'Primary relational database for data storage'
  }

  projRedis = cache 'Redis' {
    technology 'Redis'
    description 'Distributed cache and session store'
  }

  projGithubActions = external 'GitHub Actions' {
    description 'CI/CD platform for running benchmarks, tests, and linters'
  }

  projTrac = external 'Trac' {
    description 'Issue tracking system for Django development'
  }

  projDeveloper -> projDjangoFramework 'develops applications with'
  projDeveloper -> projGithubActions 'triggers CI/CD workflows'
  projDeveloper -> projTrac 'reports and tracks issues'
  
  projEndUser -> projDjangoFramework.projWsgiHandler 'accesses app via HTTPS'
  projEndUser -> projDjangoFramework.projAsgiHandler 'accesses app via WebSockets/HTTP2'
  
  projDjangoFramework.projOrm -> projPostgres 'reads/writes data' {
    technology 'SQL'
  }
  projDjangoFramework.projCacheSystem -> projRedis 'stores/retrieves cached data'
  
  projGithubActions -> projDjangoFramework 'runs tests and benchmarks on'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'The Django framework, its users, and external development tools'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Web Framework'
    description 'Core internal services and handlers of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projOrm {
    title 'Components - ORM'
    description 'Internal modules of the Django Object-Relational Mapper'
    include *
  }
}
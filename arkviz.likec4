specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'Builds and maintains applications using the Django framework'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Entry point for web servers to interface with the Django application'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/asgi.py'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps requested URLs to the appropriate view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projMiddlewareChain = component 'Middleware Chain' {
        description 'Processes requests and responses globally (CSRF, Sessions, Auth)'
        metadata {
          sourceFiles 'django/middleware/csrf.py, django/contrib/sessions/middleware.py, django/contrib/auth/middleware.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/views/generic/list.py'
        }
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML content using Django or Jinja2 templates'
        metadata {
          sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
        }
      }

      projUrlResolver -> projMiddlewareChain 'routes to'
      projMiddlewareChain -> projViewEngine 'calls'
      projViewEngine -> projTemplateEngine 'renders with'
    }

    projOrm = service 'ORM (Object-Relational Mapper)' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Built-in administration interface for managing application data'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, permissions, and groups'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/backends.py'
      }
    }

    projCacheSystem = cache 'Cache Framework' {
      technology 'Redis, Memcached, Database'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py'
      }
    }

    projTaskSystem = service 'Task System' {
      technology 'Python'
      description 'Asynchronous task execution and background processing'
      metadata {
        sourceFiles 'django/tasks/base.py, django/tasks/backends/base.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, SQLite, MySQL, Oracle'
      description 'Stores application data and Django metadata'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projWsgiHandler -> projOrm 'queries data'
    projWsgiHandler -> projAuthSystem 'authenticates users'
    projWsgiHandler -> projCacheSystem 'caches responses'
    projAdminInterface -> projWsgiHandler 'uses'
    projOrm -> projDatabase 'executes SQL'
    projTaskSystem -> projOrm 'processes data'
  }

  projExternalDb = external 'PostgreSQL Service' {
    description 'External database instance used in CI/CD and production'
  }

  projEmailServer = external 'SMTP Server' {
    description 'External service for sending emails'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses application' {
    technology 'HTTPS'
  }

  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTPS'
  }

  projDjangoFramework.projOrm -> projExternalDb 'persists data' {
    technology 'SQL'
  }

  projDjangoFramework.projWsgiHandler -> projEmailServer 'sends mail' {
    technology 'SMTP'
  }
}

deployment {
  projCI = environment 'GitHub Actions CI' {
    projTestRunner = zone 'Ubuntu Runner' {
      projPostgresNode = node 'PostgreSQL Container' {
        instanceOf projDjangoFramework.projDatabase
      }
      projDjangoNode = node 'Django Test Environment' {
        instanceOf projDjangoFramework.projWsgiHandler
      }
      projDjangoNode -> projPostgresNode 'runs tests against'
    }
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'High-level view of the Django framework and its interactions'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core internal services and data stores of the Django framework'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing components within the Django handler'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI Environment'
    description 'How Django is tested within GitHub Actions using PostgreSQL'
    include *
  }
}
specification {

  element actor {
    style {
      shape person
      color amber
    }
  }

  element system {
    style {
      shape rectangle
      color green
    }
  }

  element frontend {
    style {
      shape browser
      color sky
    }
  }

  element service {
    style {
      shape rectangle
      color blue
    }
  }

  element database {
    style {
      shape storage
      color indigo
    }
  }

  element external {
    style {
      shape rectangle
      color slate
    }
  }

  element integration {
    style {
      shape rectangle
      color secondary
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  element cache {
    style {
      shape cylinder
      color sky
    }
  }

  element component {
    style {
      shape rectangle
      color muted
    }
  }

  element mobile {
    style {
      shape mobile
      color sky
    }
  }

  deploymentNode environment {
    style {
      color green
    }
  }

  deploymentNode zone {
    style {
      color slate
    }
  }

  deploymentNode node {
    style {
      color blue
    }
  }

}

model {
  projUser = actor 'Web User' {
    description 'A user accessing web applications built with Django'
  }

  projDeveloper = actor 'Developer' {
    description 'Develops and maintains applications using the Django framework'
  }

  projDjangoFramework = system 'Django' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWsgiHandler = service 'WSGI/ASGI Handler' {
      technology 'Python, WSGI, ASGI'
      description 'Handles incoming web requests and routes them to the appropriate view'
      metadata {
        sourceFiles 'django/core/handlers/wsgi.py, django/core/asgi.py, django/core/handlers/base.py'
      }

      projMiddleware = component 'Middleware Engine' {
        description 'Hooks into Django request/response processing'
        metadata {
          sourceFiles 'django/middleware/common.py, django/middleware/csrf.py, django/middleware/security.py'
        }
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps URL patterns to view functions'
        metadata {
          sourceFiles 'django/urls/resolvers.py, django/urls/base.py'
        }
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and returns HTTP responses'
        metadata {
          sourceFiles 'django/views/generic/base.py, django/shortcuts.py'
        }
      }

      projMiddleware -> projUrlResolver 'resolves path'
      projUrlResolver -> projViewEngine 'calls view'
    }

    projOrm = service 'Object-Relational Mapper (ORM)' {
      technology 'Python, SQL'
      description 'Maps Python models to database tables and handles queries'
      metadata {
        sourceFiles 'django/db/models/base.py, django/db/models/query.py, django/db/models/manager.py'
      }
    }

    projTemplateEngine = service 'Template Engine' {
      technology 'Django Templates, Jinja2'
      description 'Renders dynamic HTML content'
      metadata {
        sourceFiles 'django/template/engine.py, django/template/backends/django.py, django/template/backends/jinja2.py'
      }
    }

    projAdminInterface = frontend 'Admin Interface' {
      technology 'Python, HTML, JavaScript'
      description 'Automatic administrative interface for model management'
      metadata {
        sourceFiles 'django/contrib/admin/sites.py, django/contrib/admin/options.py'
      }
    }

    projAuthSystem = service 'Authentication System' {
      technology 'Python'
      description 'Handles user authentication, sessions, and permissions'
      metadata {
        sourceFiles 'django/contrib/auth/models.py, django/contrib/auth/middleware.py, django/contrib/auth/backends.py'
      }
    }

    projCacheFramework = cache 'Cache Framework' {
      technology 'Memcached, Redis, Database, Local Memory'
      description 'Pluggable caching system for performance optimization'
      metadata {
        sourceFiles 'django/core/cache/__init__.py, django/core/cache/utils.py'
      }
    }

    projDatabase = database 'Relational Database' {
      technology 'PostgreSQL, MySQL, SQLite, Oracle'
      description 'Persistent storage for application data'
      metadata {
        sourceFiles 'django/db/backends/utils.py'
      }
    }

    projWsgiHandler -> projAuthSystem 'authenticates requests'
    projWsgiHandler -> projTemplateEngine 'renders views'
    projWsgiHandler -> projCacheFramework 'checks/sets cache'
    projWsgiHandler -> projOrm 'queries data'
    projOrm -> projDatabase 'executes SQL' {
      technology 'SQL'
    }
    projAdminInterface -> projWsgiHandler 'uses'
  }

  projEmailService = external 'Email Service' {
    description 'External SMTP or API-based email delivery'
  }

  projUser -> projDjangoFramework.projWsgiHandler 'accesses web app' {
    technology 'HTTP/HTTPS'
  }
  projDeveloper -> projDjangoFramework.projAdminInterface 'manages data' {
    technology 'HTTP/HTTPS'
  }
  projDjangoFramework.projWsgiHandler -> projEmailService 'sends notifications' {
    technology 'SMTP/API'
  }
}

deployment {
  projCI = environment 'GitHub Actions' {
    projTestRunner = node 'Test Runner' {
      description 'Runs Django test suite across multiple Python/DB versions'
      metadata {
        sourceFiles '.github/workflows/tests.yml, .github/workflows/coverage_tests.yml'
      }
    }
    projPostgresNode = node 'PostgreSQL Service' {
      description 'Managed PostgreSQL instance for integration testing'
      metadata {
        sourceFiles '.github/workflows/check-migrations.yml'
      }
    }
    projTestRunner -> projPostgresNode 'runs tests against'
  }
}

views {
  view projectContext {
    title 'System Context - Django Framework'
    description 'Overview of the Django framework, its users, and external integrations.'
    include *
  }

  view projectContainers of projDjangoFramework {
    title 'Containers - Django Framework'
    description 'The core architectural building blocks of the Django framework.'
    include *
  }

  view projectComponents of projDjangoFramework.projWsgiHandler {
    title 'Components - WSGI/ASGI Handler'
    description 'Internal request processing pipeline within the Django handler.'
    include *
  }

  deployment view projectDeployment {
    title 'Deployment - CI/CD Environment'
    description 'How Django is tested and validated using GitHub Actions.'
    include *
  }
}
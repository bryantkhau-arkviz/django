model {
  projUser = actor 'End User' {
    description 'A user interacting with the web application'
  }

  projAdmin = actor 'System Administrator' {
    description 'Manages the platform via the Django Admin interface'
  }

  projDeveloper = actor 'Software Developer' {
    description 'Develops and maintains the Django framework and applications'
  }

  projDjango = system 'Django Web Framework' {
    description 'A high-level Python web framework that encourages rapid development and clean, pragmatic design.'

    projWebapp = frontend 'Django Application UI' {
      technology 'HTML, CSS, JavaScript'
      description 'The user-facing interface rendered by Django templates'
    }

    projAdminInterface = frontend 'Django Admin' {
      technology 'Django Templates, JavaScript'
      description 'Automatic administrative interface for managing site content'
    }

    projAppServer = service 'Django Application Server' {
      technology 'Python, WSGI/ASGI'
      description 'Core request handling engine supporting both synchronous and asynchronous processing'

      projHandlerBase = component 'Base Handler' {
        description 'Coordinates middleware loading and request/response lifecycle'
      }

      projWsgiHandler = component 'WSGI Handler' {
        description 'Handles synchronous web requests via the WSGI protocol'
      }

      projAsgiHandler = component 'ASGI Handler' {
        description 'Handles asynchronous web requests via the ASGI protocol'
      }

      projUrlResolver = component 'URL Resolver' {
        description 'Maps incoming request URLs to the appropriate view functions'
      }

      projMiddleware = component 'Middleware Stack' {
        description 'Processes requests and responses globally (Security, Session, Auth, CSRF)'
      }

      projViewEngine = component 'View Engine' {
        description 'Executes business logic and interacts with models/templates'
      }

      projTemplateEngine = component 'Template Engine' {
        description 'Renders dynamic HTML using Django or Jinja2 templates'
      }

      projWsgiHandler -> projHandlerBase 'uses'
      projAsgiHandler -> projHandlerBase 'uses'
      projHandlerBase -> projMiddleware 'executes'
      projHandlerBase -> projUrlResolver 'resolves path'
      projUrlResolver -> projViewEngine 'calls view'
      projViewEngine -> projTemplateEngine 'renders'
    }

    projOrm = service 'Django ORM' {
      technology 'Python'
      description 'Object-Relational Mapper for database abstraction and query building'
    }

    projPostgres = database 'PostgreSQL' {
      technology 'PostgreSQL'
      description 'Primary relational database for persistent storage'
    }

    projRedis = cache 'Redis' {
      technology 'Redis'
      description 'Caching layer for performance optimization and session storage'
    }

    projTaskQueue = queue 'Task Queue' {
      technology 'Django Tasks'
      description 'Background task processing system'
    }

    projAppServer -> projOrm 'queries data'
    projOrm -> projPostgres 'executes SQL' {
      technology 'psycopg'
    }
    projAppServer -> projRedis 'caches data'
    projAppServer -> projTaskQueue 'enqueues tasks'
    projWebapp -> projAppServer 'sends requests' {
      technology 'HTTP/HTTPS'
    }
    projAdminInterface -> projAppServer 'manages data' {
      technology 'HTTP/HTTPS'
    }
  }

  projEmailService = external 'Email Provider' {
    technology 'SMTP/API'
    description 'External service for sending notifications and password resets'
  }

  projGithubActions = external 'GitHub Actions' {
    technology 'YAML'
    description 'CI/CD platform for running tests, benchmarks, and linters'
  }

  projUser -> projDjango.projWebapp 'browses site'
  projAdmin -> projDjango.projAdminInterface 'manages content'
  projDeveloper -> projGithubActions 'pushes code'
  projDjango.projAppServer -> projEmailService 'sends emails'
  projGithubActions -> projDjango 'runs tests and benchmarks'
}

views {
  view projectContext {
    title 'System Context - Django Web Framework'
    description 'Overview of the Django system, its users, and external integrations'
    include *
  }

  view projectContainers of projDjango {
    title 'Containers - Django Web Framework'
    description 'High-level architecture showing the web server, ORM, and data stores'
    include *
  }

  view projectComponents of projDjango.projAppServer {
    title 'Components - Django Application Server'
    description 'Internal request processing components within the Django server'
    include *
  }
}